<div class="container mx-auto p-4">
  <div class="flex items-center justify-between mb-6">
    <h1 class="font-bold text-4xl">Members</h1>
    <%= link_to "New Member", new_member_path, class: "rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white font-medium" %>
  </div>

  <% if @members.any? %>
    <div class="overflow-x-auto">
      <table class="w-full text-left">
        <thead>
          <tr class="border-b border-gray-300">
            <th class="py-3 px-4 font-semibold">Name</th>
            <th class="py-3 px-4 font-semibold hidden sm:table-cell">Email</th>
            <th class="py-3 px-4 font-semibold hidden md:table-cell">Phone</th>
            <th class="py-3 px-4 font-semibold hidden lg:table-cell">Birthday</th>
            <th class="py-3 px-4 font-semibold">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% @members.each do |member| %>
            <%= render "members/member_row", member: member %>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p class="text-gray-500">No members have been added yet.</p>
  <% end %>
</div>
