<% content_for :title, "Contact Us — West Baton Rouge Presbyterian Church" %>

<div class="container mx-auto px-4 py-12 max-w-5xl">
  <h1 class="font-marcellus text-4xl text-stone-900 mb-2">Contact Us</h1>
  <p class="text-stone-600 mb-10">We'd love to hear from you. Reach out anytime.</p>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">

    <%# Contact Information %>
    <div>
      <h2 class="font-marcellus text-2xl text-stone-900 border-b-2 border-amber-500 pb-2 inline-block mb-6">Get in Touch</h2>

      <div class="space-y-5 text-stone-700">
        <div class="flex gap-3 items-start">
          <svg class="mt-1 shrink-0 text-amber-500" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
          <div>
            <p class="font-semibold text-stone-800">Address</p>
            <p>640 Florida Ave</p>
            <p>Port Allen, LA 70767</p>
          </div>
        </div>

        <div class="flex gap-3 items-start">
          <svg class="mt-1 shrink-0 text-amber-500" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/></svg>
          <div>
            <p class="font-semibold text-stone-800">Phone</p>
            <p><a href="tel:+12253441486" class="hover:text-amber-700 transition-colors">(225) 344-1486</a></p>
          </div>
        </div>

        <div class="flex gap-3 items-start">
          <svg class="mt-1 shrink-0 text-amber-500" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/></svg>
          <div>
            <p class="font-semibold text-stone-800">Email</p>
            <p><a href="mailto:office@wbrpres.org" class="hover:text-amber-700 transition-colors">office@wbrpres.org</a></p>
          </div>
        </div>

        <div class="flex gap-3 items-start">
          <svg class="mt-1 shrink-0 text-amber-500" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 14.5v-9l6 4.5-6 4.5z"/></svg>

          <div>
            <p class="font-semibold text-stone-800">Worship Times</p>
            <p>Worship Service — 11:00 AM</p>
            <p>Bible Study — Wednesdays at 10:00 AM</p>
          </div>
        </div>
      </div>

      <%# Map placeholder %>
      <%#
        <div class="mt-8 rounded-lg overflow-hidden border border-stone-200">
          <iframe
            src="https://www.google.com/maps/embed?pb=..."
            width="100%"
            height="300"
            style="border:0;"
            allowfullscreen=""
            loading="lazy">
          </iframe>
        </div>
      %>
    </div>

    <%# Contact Form (non-functional placeholder) %>
    <div>
      <h2 class="font-marcellus text-2xl text-stone-900 border-b-2 border-amber-500 pb-2 inline-block mb-6">Send a Message</h2>
      <form class="space-y-5" action="#" method="post">
        <div>
          <label class="block text-sm font-medium text-stone-700 mb-1" for="contact_name">Your Name</label>
          <input type="text" id="contact_name" name="name" placeholder="Jane Smith"
                 class="block w-full rounded-md border border-stone-300 px-3 py-2 shadow-sm focus:outline-none focus:ring-2 focus:ring-amber-400 focus:border-amber-400">
        </div>
        <div>
          <label class="block text-sm font-medium text-stone-700 mb-1" for="contact_email">Email Address</label>
          <input type="email" id="contact_email" name="email" placeholder="jane@example.com"
                 class="block w-full rounded-md border border-stone-300 px-3 py-2 shadow-sm focus:outline-none focus:ring-2 focus:ring-amber-400 focus:border-amber-400">
        </div>
        <div>
          <label class="block text-sm font-medium text-stone-700 mb-1" for="contact_message">Message</label>
          <textarea id="contact_message" name="message" rows="5" placeholder="How can we help you?"
                    class="block w-full rounded-md border border-stone-300 px-3 py-2 shadow-sm focus:outline-none focus:ring-2 focus:ring-amber-400 focus:border-amber-400 resize-y"></textarea>
        </div>
        <button type="submit" class="bg-stone-700 hover:bg-stone-600 text-white font-semibold px-6 py-2.5 rounded-md transition-colors cursor-pointer">
          Send Message
        </button>
      </form>
    </div>

  </div>
</div>
