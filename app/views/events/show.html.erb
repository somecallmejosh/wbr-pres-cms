<div class="container mx-auto px-4 py-8">
  <div class="mb-6">
    <%= link_to "&larr; Back to Events".html_safe, events_path, class: "text-amber-700 hover:text-amber-800 transition-colors font-medium" %>
  </div>

  <div class="max-w-3xl">
    <div class="flex items-start justify-between mb-4">
      <div>
        <h1 class="font-marcellus text-4xl text-stone-900 mb-2"><%= @event.title %></h1>
        <%= render "shared/category_badge", category: @event.category %>
      </div>
      <% if authenticated? %>
        <div class="flex gap-2 shrink-0 ml-4">
          <%= link_to "Edit", edit_event_path(@event), class: "rounded-md px-4 py-2 bg-stone-700 hover:bg-stone-600 text-white font-medium transition-colors" %>
          <%= button_to "Delete", event_path(@event), method: :delete,
                class: "rounded-md px-4 py-2 bg-red-700 hover:bg-red-600 text-white font-medium cursor-pointer transition-colors",
                data: { turbo_confirm: "Are you sure you want to delete this event?" } %>
        </div>
      <% end %>
    </div>

    <dl class="divide-y divide-stone-200 mt-6">
      <div class="py-3 sm:grid sm:grid-cols-3 sm:gap-4">
        <dt class="font-semibold text-stone-700">Date</dt>
        <dd class="sm:col-span-2 text-stone-800"><%= full_date_ordinal_with_year(@event.event_date) %></dd>
      </div>

      <div class="py-3 sm:grid sm:grid-cols-3 sm:gap-4">
        <dt class="font-semibold text-stone-700">Time</dt>
        <dd class="sm:col-span-2 text-stone-800"><%= event_time_range(@event) %></dd>
      </div>

      <% if @event.location.present? %>
        <div class="py-3 sm:grid sm:grid-cols-3 sm:gap-4">
          <dt class="font-semibold text-stone-700">Location</dt>
          <dd class="sm:col-span-2 text-stone-800"><%= @event.location %></dd>
        </div>
      <% end %>

      <% if @event.description.present? %>
        <div class="py-3 sm:grid sm:grid-cols-3 sm:gap-4">
          <dt class="font-semibold text-stone-700">Description</dt>
          <dd class="sm:col-span-2 text-stone-700"><%= simple_format(@event.description) %></dd>
        </div>
      <% end %>
    </dl>
  </div>
</div>
