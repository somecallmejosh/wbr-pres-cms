<div class="bg-white flex flex-col relative group transition-all hover:shadow-lg duration-200">
  <div class="p-4 flex-1">
    <div class="flex items-center justify-between mb-2">
      <span class="text-sm text-stone-600"><%= full_date_ordinal(event.event_date) %></span>
    </div>
    <h3 class="font-marcellus text-lg text-stone-900 mb-1 group-hover:text-amber-700 transition-colors">
      <%= event.title %>
    </h3>
    <p class="text-sm text-stone-600 mb-2"><%= event_time_range(event) %></p>
    <% if event.location.present? %>
      <p class="text-sm text-stone-600"><%= event.location %></p>
    <% end %>

  </div>
  <%= link_to event_path(event), class: "absolute inset-0 block" do %>
    <span class="sr-only"><%= event.title %></span>
  <% end %>
</div>
