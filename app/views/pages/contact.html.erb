<% content_for :title, "Contact Us — West Baton Rouge Presbyterian Church" %>

<%= render "shared/page_header",
      eyebrow: "Reach Out",
      title: "Contact Us",
      subtitle: "We'd love to hear from you — whether you're planning a first visit or just have a question." %>

<div class="container mx-auto max-w-5xl px-4 py-16 md:py-20">
  <div class="grid grid-cols-1 gap-12 lg:grid-cols-2 lg:gap-16">

    <%# Contact Information %>
    <div data-controller="reveal">
      <span class="inline-block rounded-full bg-amber-700/10 px-3 py-1 text-[11px] font-medium uppercase tracking-[0.25em] text-amber-800">Get in Touch</span>
      <h2 class="font-marcellus mt-5 text-2xl text-stone-900 md:text-3xl">Find us &amp; say hello</h2>
      <div class="mt-5 h-px w-16 bg-amber-600"></div>

      <div class="mt-8 space-y-6 text-stone-700">
        <div class="flex items-start gap-4">
          <span class="flex size-10 shrink-0 items-center justify-center rounded-full bg-amber-700/10 text-amber-700">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
          </span>
          <div>
            <p class="font-semibold text-stone-900">Address</p>
            <p class="text-stone-600">640 Florida Ave</p>
            <p class="text-stone-600">Port Allen, LA 70767</p>
          </div>
        </div>

        <div class="flex items-start gap-4">
          <span class="flex size-10 shrink-0 items-center justify-center rounded-full bg-amber-700/10 text-amber-700">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/></svg>
          </span>
          <div>
            <p class="font-semibold text-stone-900">Phone</p>
            <p><a href="tel:+12253441486" class="text-stone-600 transition-colors hover:text-amber-700">(225) 344-1486</a></p>
          </div>
        </div>

        <div class="flex items-start gap-4">
          <span class="flex size-10 shrink-0 items-center justify-center rounded-full bg-amber-700/10 text-amber-700">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/></svg>
          </span>
          <div>
            <p class="font-semibold text-stone-900">Email</p>
            <p><a href="mailto:office@wbrpres.org" class="text-stone-600 transition-colors hover:text-amber-700">office@wbrpres.org</a></p>
          </div>
        </div>

        <div class="flex items-start gap-4">
          <span class="flex size-10 shrink-0 items-center justify-center rounded-full bg-amber-700/10 text-amber-700">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 14.5v-9l6 4.5-6 4.5z"/></svg>
          </span>
          <div>
            <p class="font-semibold text-stone-900">Worship Times</p>
            <p class="text-stone-600">Worship Service — 11:00 AM</p>
            <p class="text-stone-600">Bible Study — Wednesdays at 10:00 AM</p>
          </div>
        </div>
      </div>
    </div>

    <%# Contact Form %>
    <div data-controller="reveal" data-reveal-delay-value="120">
      <div class="rounded-[2rem] bg-white p-8 ring-1 ring-stone-900/5 shadow-[0_24px_60px_-30px_rgba(68,64,60,0.4)] md:p-10">
        <h2 class="font-marcellus text-2xl text-stone-900 md:text-3xl">Send a Message</h2>
        <div class="mt-4 h-px w-16 bg-amber-600"></div>
        <%= form_with url: pages_contact_path, method: :post, local: true, class: "mt-8 space-y-5" do %>
          <div>
            <label class="mb-1.5 block text-sm font-medium text-stone-700" for="contact_name">Your Name</label>
            <input type="text" id="contact_name" name="name" placeholder="Jane Smith"
                   class="block w-full rounded-xl border border-stone-200 bg-stone-50 px-4 py-2.5 transition-all duration-300 ease-[cubic-bezier(0.32,0.72,0,1)] focus:border-amber-400 focus:bg-white focus:outline-none focus:ring-2 focus:ring-amber-400/40">
          </div>
          <div>
            <label class="mb-1.5 block text-sm font-medium text-stone-700" for="contact_email">Email Address</label>
            <input type="email" id="contact_email" name="email" placeholder="jane@example.com"
                   class="block w-full rounded-xl border border-stone-200 bg-stone-50 px-4 py-2.5 transition-all duration-300 ease-[cubic-bezier(0.32,0.72,0,1)] focus:border-amber-400 focus:bg-white focus:outline-none focus:ring-2 focus:ring-amber-400/40">
          </div>
          <div>
            <label class="mb-1.5 block text-sm font-medium text-stone-700" for="contact_message">Message</label>
            <textarea id="contact_message" name="message" rows="5" placeholder="How can we help you?"
                      class="block w-full resize-y rounded-xl border border-stone-200 bg-stone-50 px-4 py-2.5 transition-all duration-300 ease-[cubic-bezier(0.32,0.72,0,1)] focus:border-amber-400 focus:bg-white focus:outline-none focus:ring-2 focus:ring-amber-400/40"></textarea>
          </div>
          <button type="submit" class="group inline-flex cursor-pointer items-center gap-3 rounded-full bg-stone-800 py-2 pl-6 pr-2 font-semibold text-white transition-all duration-500 ease-[cubic-bezier(0.32,0.72,0,1)] hover:bg-stone-700 active:scale-[0.98]">
            <span>Send Message</span>
            <span class="flex h-9 w-9 items-center justify-center rounded-full bg-white/15 transition-transform duration-500 ease-[cubic-bezier(0.32,0.72,0,1)] group-hover:translate-x-0.5">
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </span>
          </button>
        <% end %>
      </div>
    </div>

  </div>
</div>
