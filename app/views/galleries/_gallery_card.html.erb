<article class="bg-white rounded-lg border border-stone-200 shadow-sm overflow-hidden flex flex-col">
  <% if gallery.cover_image %>
    <%= link_to gallery_path(gallery), aria: { label: gallery.title } do %>
      <img src="<%= gallery.cover_image.thumbnail_url(width: 800, height: 450) %>"
           alt=""
           aria-hidden="true"
           class="w-full aspect-[16/9] object-cover">
    <% end %>
  <% else %>
    <div class="w-full aspect-[16/9] bg-stone-100 flex items-center justify-center text-stone-400 text-sm" aria-hidden="true">
      No images
    </div>
  <% end %>

  <div class="p-4 flex-1 flex flex-col">
    <h2 class="font-marcellus text-lg text-stone-900">
      <%= link_to gallery.title, gallery_path(gallery), class: "hover:text-amber-700 transition-colors" %>
    </h2>
    <p class="text-sm text-stone-600 mt-1"><%= pluralize(gallery.images.size, "image") %></p>
    <% if gallery.description.present? %>
      <p class="text-stone-700 mt-2 text-sm line-clamp-2"><%= gallery.description %></p>
    <% end %>
    <% if authenticated? %>
      <div class="mt-3 pt-3 border-t border-stone-100">
        <%= link_to "Edit", edit_gallery_path(gallery), class: "text-sm text-amber-700 hover:text-amber-800 font-medium transition-colors" %>
      </div>
    <% end %>
  </div>
</article>
