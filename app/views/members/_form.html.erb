<%= form_with model: member, class: "max-w-2xl" do |form| %>
  <% if member.errors.any? %>
    <div class="bg-red-50 border border-red-300 rounded-md p-4 mb-6">
      <h2 class="font-semibold text-red-800"><%= pluralize(member.errors.count, "error") %> prevented this member from being saved:</h2>
      <ul class="list-disc list-inside mt-2 text-red-700">
        <% member.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    <div>
      <%= form.label :first_name, class: "block font-semibold text-gray-700 mb-1" %>
      <%= form.text_field :first_name, required: true, class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 w-full" %>
    </div>

    <div>
      <%= form.label :last_name, class: "block font-semibold text-gray-700 mb-1" %>
      <%= form.text_field :last_name, required: true, class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 w-full" %>
    </div>

    <div>
      <%= form.label :email, class: "block font-semibold text-gray-700 mb-1" %>
      <%= form.email_field :email, class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 w-full" %>
    </div>

    <div>
      <%= form.label :phone, class: "block font-semibold text-gray-700 mb-1" %>
      <%= form.telephone_field :phone, class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 w-full" %>
    </div>

    <div>
      <%= form.label :date_of_birth, class: "block font-semibold text-gray-700 mb-1" %>
      <%= form.date_field :date_of_birth, class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 w-full" %>
    </div>
  </div>

  <fieldset class="mt-6">
    <legend class="font-semibold text-gray-700 mb-2">Address</legend>
    <div class="grid grid-cols-1 gap-4">
      <div>
        <%= form.label :address_line1, "Address Line 1", class: "block font-semibold text-gray-700 mb-1" %>
        <%= form.text_field :address_line1, class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 w-full" %>
      </div>

      <div>
        <%= form.label :address_line2, "Address Line 2", class: "block font-semibold text-gray-700 mb-1" %>
        <%= form.text_field :address_line2, class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 w-full" %>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div>
          <%= form.label :city, class: "block font-semibold text-gray-700 mb-1" %>
          <%= form.text_field :city, class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 w-full" %>
        </div>

        <div>
          <%= form.label :state, class: "block font-semibold text-gray-700 mb-1" %>
          <%= form.text_field :state, maxlength: 2, placeholder: "XX", class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 w-full" %>
        </div>

        <div>
          <%= form.label :zip_code, "Zip Code", class: "block font-semibold text-gray-700 mb-1" %>
          <%= form.text_field :zip_code, placeholder: "12345", class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 w-full" %>
        </div>
      </div>
    </div>
  </fieldset>

  <div class="mt-6">
    <%= form.submit class: "rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white font-medium cursor-pointer" %>
  </div>
<% end %>
