<a href="#main-content" class="absolute -top-full focus:top-0 focus:left-0">Skip to main content</a>
<header class="sticky top-0 z-50 bg-white shadow">
  <nav aria-label="Main navigation" class="px-4">
    <div class="container mx-auto flex items-center justify-between py-4">
      <div class="flex items-center gap-4">
        <img src="https://res.cloudinary.com/dwjulenau/image/upload/v1765035098/WBR%20Presbyterian/logo.png" alt="Logo" class="size-16">
        <a href="/" class="text-xl font-bold">WBR Pres CMS</a>
      </div>
      <div>
        <ul class="hidden lg:flex space-x-4">
          <li>
            <%= link_to "Home", root_path, class: "hover:underline" %>
          </li>
          <li><%= link_to "Events", events_path, class: "hover:underline" %></li>
          <li><%= link_to "Galleries", galleries_path, class: "hover:underline" %></li>
          <li><%= link_to "About", pages_about_path, class: "hover:underline" %></li>
          <li><%= link_to "Contact", pages_contact_path, class: "hover:underline" %></li>
          <% if authenticated? %>
            <li class="border-l-2 border-gray-200 pl-4"><%= link_to "Members", members_path, class: "hover:underline" %></li>
            <li><%= link_to "Image Library", admin_images_path, class: "hover:underline" %></li>
          <% end %>
        </ul>
        <button @click="menuOpen = !menuOpen" aria-label="Toggle menu" class="ml-4 lg:hidden">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path fill="currentColor" d="M3 18v-2h18v2zm0-5v-2h18v2zm0-5V6h18v2z"/></svg>
        </button>
      </div>
    </div>
  </nav>
</header>
<div x-show="menuOpen" x-transition.scale.origin.top @click.away="menuOpen = false" class="bg-white shadow-md lg:hidden">
  <div class="container mx-auto p-4">
    <ul class="divide-y divide-gray-200">
      <li>
        <%= link_to "Home", root_path, class: "hover:underline block py-2" %>
      </li>
      <li><%= link_to "Events", events_path, class: "hover:underline block py-2" %></li>
      <li><%= link_to "Galleries", galleries_path, class: "hover:underline block py-2" %></li>
      <li><%= link_to "About", pages_about_path, class: "hover:underline block py-2" %></li>
      <li><%= link_to "Contact", pages_contact_path, class: "hover:underline block py-2" %></li>
      <% if authenticated? %>
        <li><%= link_to "Members", members_path, class: "hover:underline block py-2" %></li>
        <li><%= link_to "Images Library", admin_images_path, class: "hover:underline block py-2" %></li>
      <% end %>
    </ul>
  </div>
</div>
