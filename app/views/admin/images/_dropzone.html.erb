<%# Shared file-input group for the upload form (full page + modal), with
    live thumbnail previews of the chosen photos before upload. %>
<div data-controller="upload-preview">
  <label for="files" class="group flex cursor-pointer flex-col items-center justify-center gap-3 rounded-2xl border-2 border-dashed border-stone-300 bg-stone-50 px-6 py-12 text-center transition-colors hover:border-amber-400 hover:bg-amber-50/50">
    <span class="flex size-12 items-center justify-center rounded-2xl bg-amber-100 text-amber-700 transition-colors group-hover:bg-amber-200">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="16 16 12 12 8 16"/><line x1="12" y1="12" x2="12" y2="21"/><path d="M20.39 18.39A5 5 0 0 0 18 9h-1.26A8 8 0 1 0 3 16.3"/></svg>
    </span>
    <span class="font-medium text-stone-800">Choose photos to upload
      <span class="text-red-500" aria-hidden="true">*</span>
      <span class="sr-only">(required)</span>
    </span>
    <span class="text-sm text-stone-500">Click here, then select one or more photos from your device.</span>
  </label>
  <input type="file"
         name="files[]"
         id="files"
         accept="image/jpeg,image/png,image/webp,image/gif"
         multiple
         required
         aria-describedby="files-hint"
         data-upload-preview-target="input"
         data-action="upload-preview#add"
         class="mt-4 block w-full cursor-pointer text-sm text-stone-600 file:mr-4 file:rounded-full file:border-0 file:bg-stone-100 file:px-4 file:py-2 file:text-sm file:font-medium file:text-stone-800 hover:file:bg-stone-200">
  <p id="files-hint" class="field-hint">Hold Shift or Ctrl/Cmd to select several photos at once (up to 20).</p>

  <%# Live previews — populated client-side as photos are chosen. %>
  <div data-upload-preview-target="preview" class="mt-5 hidden">
    <div class="mb-2 flex items-baseline justify-between">
      <p class="field-label !mb-0">Ready to upload</p>
      <span class="text-xs text-stone-400"><span data-upload-preview-target="count">0</span> selected</span>
    </div>
    <div data-upload-preview-target="list" class="grid grid-cols-3 gap-3 sm:grid-cols-4"></div>
  </div>

  <template data-upload-preview-target="template">
    <div data-tile class="group/tile relative">
      <div class="overflow-hidden rounded-xl border-2 border-stone-200 bg-stone-100">
        <img data-preview-img alt="" class="aspect-square w-full object-cover">
      </div>
      <button type="button" data-action="upload-preview#remove" aria-label="Remove photo"
              class="absolute -right-2 -top-2 flex size-6 items-center justify-center rounded-full bg-stone-800 text-white shadow-sm ring-2 ring-white transition duration-300 ease-[cubic-bezier(0.32,0.72,0,1)] hover:bg-red-600 active:scale-95 focus:outline-none focus-visible:ring-2 focus-visible:ring-amber-400">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" class="pointer-events-none size-3.5"><path d="M6 6l12 12M18 6 6 18"/></svg>
      </button>
      <p data-preview-name class="mt-1 truncate text-xs text-stone-600"></p>
    </div>
  </template>
</div>
