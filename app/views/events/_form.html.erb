<%= form_with model: event, class: "max-w-2xl" do |form| %>
  <% if event.errors.any? %>
    <div class="bg-red-50 border border-red-300 rounded-md p-4 mb-6">
      <h2 class="font-semibold text-red-800"><%= pluralize(event.errors.count, "error") %> prevented this event from being saved:</h2>
      <ul class="list-disc list-inside mt-2 text-red-700">
        <% event.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid grid-cols-1 gap-4">
    <div>
      <%= form.label :title, class: "block font-semibold text-gray-700 mb-1" %>
      <%= form.text_field :title, required: true, class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 w-full" %>
    </div>

    <div>
      <%= form.label :description, class: "block font-semibold text-gray-700 mb-1" %>
      <%= form.text_area :description, rows: 4, class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 w-full" %>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
      <div>
        <%= form.label :event_date, "Date", class: "block font-semibold text-gray-700 mb-1" %>
        <%= form.date_field :event_date, required: true, class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 w-full" %>
      </div>

      <div>
        <%= form.label :start_time, "Start Time", class: "block font-semibold text-gray-700 mb-1" %>
        <%= form.time_field :start_time, required: true, class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 w-full" %>
      </div>

      <div>
        <%= form.label :end_time, "End Time", class: "block font-semibold text-gray-700 mb-1" %>
        <%= form.time_field :end_time, class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 w-full" %>
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <%= form.label :location, class: "block font-semibold text-gray-700 mb-1" %>
        <%= form.text_field :location, class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 w-full" %>
      </div>

      <div>
        <%= form.label :category, class: "block font-semibold text-gray-700 mb-1" %>
        <%= form.select :category, Event::CATEGORY_LABELS.map { |value, label| [label, value] }, { include_blank: "Select a category" }, required: true, class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 w-full" %>
      </div>
    </div>
  </div>

  <div class="mt-6">
    <%= form.submit class: "rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white font-medium cursor-pointer" %>
  </div>
<% end %>
