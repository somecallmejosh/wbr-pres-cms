<div class="container mx-auto p-4">
  <div class="mb-6">
    <%= link_to "&larr; Back to Members".html_safe, members_path, class: "text-blue-700 hover:underline" %>
  </div>

  <div class="max-w-2xl">
    <div class="flex items-center justify-between mb-6">
      <h1 class="font-bold text-4xl"><%= @member.full_name %></h1>
      <div class="flex gap-2">
        <%= link_to "Edit", edit_member_path(@member), class: "rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white font-medium" %>
        <%= button_to "Delete", member_path(@member), method: :delete, class: "rounded-md px-3.5 py-2.5 bg-red-600 hover:bg-red-500 text-white font-medium cursor-pointer", data: { turbo_confirm: "Are you sure you want to delete this member?" } %>
      </div>
    </div>

    <dl class="divide-y divide-gray-200">
      <% if @member.email.present? %>
        <div class="py-3 sm:grid sm:grid-cols-3 sm:gap-4">
          <dt class="font-semibold text-gray-700">Email</dt>
          <dd class="sm:col-span-2"><%= mail_to @member.email, @member.email, class: "text-blue-700 hover:underline" %></dd>
        </div>
      <% end %>

      <% if @member.phone.present? %>
        <div class="py-3 sm:grid sm:grid-cols-3 sm:gap-4">
          <dt class="font-semibold text-gray-700">Phone</dt>
          <dd class="sm:col-span-2"><%= @member.phone %></dd>
        </div>
      <% end %>

      <% if @member.date_of_birth.present? %>
        <div class="py-3 sm:grid sm:grid-cols-3 sm:gap-4">
          <dt class="font-semibold text-gray-700">Birthday</dt>
          <dd class="sm:col-span-2"><%= @member.birthday_display %></dd>
        </div>
      <% end %>

      <% if [@member.address_line1, @member.city, @member.state, @member.zip_code].any?(&:present?) %>
        <div class="py-3 sm:grid sm:grid-cols-3 sm:gap-4">
          <dt class="font-semibold text-gray-700">Address</dt>
          <dd class="sm:col-span-2">
            <% if @member.address_line1.present? %>
              <div><%= @member.address_line1 %></div>
            <% end %>
            <% if @member.address_line2.present? %>
              <div><%= @member.address_line2 %></div>
            <% end %>
            <% if @member.city.present? || @member.state.present? || @member.zip_code.present? %>
              <div>
                <%= [@member.city, @member.state].compact_blank.join(", ") %>
                <%= @member.zip_code %>
              </div>
            <% end %>
          </dd>
        </div>
      <% end %>
    </dl>
  </div>
</div>
