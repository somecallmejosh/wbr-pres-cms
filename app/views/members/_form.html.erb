<%= form_with model: member do |form| %>
  <%= render "shared/form_errors", record: member %>

  <div class="admin-shell">
    <div class="admin-core p-6 sm:p-8">

      <section>
        <h2 class="font-marcellus text-xl text-stone-900">Contact details</h2>
        <p class="mt-1 text-sm text-stone-500">Name is required. Everything else is optional.</p>

        <div class="mt-5 grid grid-cols-1 gap-5 sm:grid-cols-2">
          <div>
            <%= form.label :first_name, class: "field-label" %>
            <%= form.text_field :first_name, required: true, class: "field-input" %>
          </div>

          <div>
            <%= form.label :last_name, class: "field-label" %>
            <%= form.text_field :last_name, required: true, class: "field-input" %>
          </div>

          <div>
            <%= form.label :email, class: "field-label" %>
            <%= form.email_field :email, class: "field-input" %>
          </div>

          <div>
            <%= form.label :phone, class: "field-label" %>
            <%= form.telephone_field :phone, class: "field-input" %>
          </div>

          <div>
            <%= form.label :date_of_birth, "Date of birth", class: "field-label" %>
            <%= form.date_field :date_of_birth, class: "field-input" %>
          </div>
        </div>
      </section>

      <hr class="my-8 border-stone-200">

      <section>
        <h2 class="font-marcellus text-xl text-stone-900">Address</h2>
        <p class="mt-1 text-sm text-stone-500">Where this member lives. Leave blank if you don't have it.</p>

        <div class="mt-5 grid grid-cols-1 gap-5">
          <div>
            <%= form.label :address_line1, "Address line 1", class: "field-label" %>
            <%= form.text_field :address_line1, class: "field-input" %>
          </div>

          <div>
            <%= form.label :address_line2, "Address line 2", class: "field-label" %>
            <%= form.text_field :address_line2, class: "field-input" %>
          </div>

          <div class="grid grid-cols-1 gap-5 sm:grid-cols-3">
            <div>
              <%= form.label :city, class: "field-label" %>
              <%= form.text_field :city, class: "field-input" %>
            </div>

            <div>
              <%= form.label :state, class: "field-label" %>
              <%= form.text_field :state, maxlength: 2, placeholder: "XX", class: "field-input uppercase" %>
            </div>

            <div>
              <%= form.label :zip_code, "Zip code", class: "field-label" %>
              <%= form.text_field :zip_code, placeholder: "12345", class: "field-input" %>
            </div>
          </div>
        </div>
      </section>

      <%= render "shared/admin_action_bar", form: form, label: "Save member", cancel_path: members_path %>

    </div>
  </div>
<% end %>
