<%# Gallery details form (title / description / published).
  Image membership is managed separately by the two-pane photo editor, so this
  form only persists the gallery's own attributes. %>
<%= form_with model: gallery do |form| %>
  <%= render "shared/form_errors", record: gallery %>

  <div class="admin-shell">
    <div class="admin-core p-6 sm:p-8">
      <%= render "galleries/details_fields", form: form, intro: "Update the album's title, description, and visibility." %>
      <%= render "shared/admin_action_bar", form: form, label: "Save gallery", cancel_path: galleries_path %>
    </div>
  </div>
<% end %>
