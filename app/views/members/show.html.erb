<div class="container mx-auto px-4 py-8">
  <div class="mb-6">
    <%= link_to "&larr; Back to Members".html_safe, members_path, class: "text-amber-700 hover:text-amber-800 transition-colors font-medium" %>
  </div>

  <div class="max-w-2xl">
    <div class="flex items-center justify-between mb-6">
      <h1 class="font-marcellus text-4xl text-stone-900"><%= @member.full_name %></h1>
      <div class="flex gap-2">
        <%= link_to "Edit", edit_member_path(@member), class: "rounded-md px-4 py-2 bg-stone-700 hover:bg-stone-600 text-white font-medium transition-colors" %>
        <%= button_to "Delete", member_path(@member), method: :delete,
              class: "rounded-md px-4 py-2 bg-red-700 hover:bg-red-600 text-white font-medium cursor-pointer transition-colors",
              data: { turbo_confirm: "Are you sure you want to delete this member?" } %>
      </div>
    </div>

    <dl class="divide-y divide-stone-200">
      <% if @member.email.present? %>
        <div class="py-3 sm:grid sm:grid-cols-3 sm:gap-4">
          <dt class="font-semibold text-stone-700">Email</dt>
          <dd class="sm:col-span-2"><%= mail_to @member.email, @member.email, class: "text-amber-700 hover:text-amber-800 transition-colors" %></dd>
        </div>
      <% end %>

      <% if @member.phone.present? %>
        <div class="py-3 sm:grid sm:grid-cols-3 sm:gap-4">
          <dt class="font-semibold text-stone-700">Phone</dt>
          <dd class="sm:col-span-2 text-stone-800"><%= @member.phone %></dd>
        </div>
      <% end %>

      <% if @member.date_of_birth.present? %>
        <div class="py-3 sm:grid sm:grid-cols-3 sm:gap-4">
          <dt class="font-semibold text-stone-700">Birthday</dt>
          <dd class="sm:col-span-2 text-stone-800"><%= @member.birthday_display %></dd>
        </div>
      <% end %>

      <% if [@member.address_line1, @member.city, @member.state, @member.zip_code].any?(&:present?) %>
        <div class="py-3 sm:grid sm:grid-cols-3 sm:gap-4">
          <dt class="font-semibold text-stone-700">Address</dt>
          <dd class="sm:col-span-2 text-stone-800">
            <% if @member.address_line1.present? %>
              <div><%= @member.address_line1 %></div>
            <% end %>
            <% if @member.address_line2.present? %>
              <div><%= @member.address_line2 %></div>
            <% end %>
            <% if @member.city.present? || @member.state.present? || @member.zip_code.present? %>
              <div>
                <%= [@member.city, @member.state].compact_blank.join(", ") %>
                <%= @member.zip_code %>
              </div>
            <% end %>
          </dd>
        </div>
      <% end %>
    </dl>
  </div>
</div>
