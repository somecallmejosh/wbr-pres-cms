<% content_for :title, "#{@member.full_name} — Member" %>

<div class="container mx-auto max-w-2xl px-4 py-10 md:py-14">
  <%= link_to members_path, class: "group inline-flex items-center gap-1.5 text-sm font-medium text-stone-500 transition-colors hover:text-amber-700" do %>
    <svg class="size-4 transition-transform group-hover:-translate-x-0.5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
    Back to Members
  <% end %>

  <header class="mt-6 mb-8 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between" data-controller="reveal">
    <div>
      <span class="eyebrow">Member</span>
      <h1 class="font-marcellus mt-4 text-4xl text-stone-900"><%= @member.full_name %></h1>
    </div>
    <div class="flex shrink-0 gap-2">
      <%= link_to "Edit", edit_member_path(@member), class: "btn-secondary" %>
      <%= button_to "Delete", member_path(@member), method: :delete,
            class: "btn-danger",
            data: { turbo_confirm: "Are you sure you want to delete this member?" } %>
    </div>
  </header>

  <div class="admin-shell" data-controller="reveal" data-reveal-delay-value="80">
    <div class="admin-core p-6 sm:p-8">
      <dl class="divide-y divide-stone-100">
        <% if @member.email.present? %>
          <div class="grid grid-cols-1 gap-1 py-4 first:pt-0 sm:grid-cols-3 sm:gap-4">
            <dt class="text-sm font-medium uppercase tracking-wide text-stone-400">Email</dt>
            <dd class="sm:col-span-2"><%= mail_to @member.email, @member.email, class: "text-amber-700 transition-colors hover:text-amber-800" %></dd>
          </div>
        <% end %>

        <% if @member.phone.present? %>
          <div class="grid grid-cols-1 gap-1 py-4 sm:grid-cols-3 sm:gap-4">
            <dt class="text-sm font-medium uppercase tracking-wide text-stone-400">Phone</dt>
            <dd class="text-stone-800 sm:col-span-2"><%= @member.phone %></dd>
          </div>
        <% end %>

        <% if @member.date_of_birth.present? %>
          <div class="grid grid-cols-1 gap-1 py-4 sm:grid-cols-3 sm:gap-4">
            <dt class="text-sm font-medium uppercase tracking-wide text-stone-400">Birthday</dt>
            <dd class="text-stone-800 sm:col-span-2"><%= @member.birthday_display %></dd>
          </div>
        <% end %>

        <% if [@member.address_line1, @member.city, @member.state, @member.zip_code].any?(&:present?) %>
          <div class="grid grid-cols-1 gap-1 py-4 last:pb-0 sm:grid-cols-3 sm:gap-4">
            <dt class="text-sm font-medium uppercase tracking-wide text-stone-400">Address</dt>
            <dd class="text-stone-800 sm:col-span-2">
              <% if @member.address_line1.present? %>
                <div><%= @member.address_line1 %></div>
              <% end %>
              <% if @member.address_line2.present? %>
                <div><%= @member.address_line2 %></div>
              <% end %>
              <% if @member.city.present? || @member.state.present? || @member.zip_code.present? %>
                <div>
                  <%= [@member.city, @member.state].compact_blank.join(", ") %>
                  <%= @member.zip_code %>
                </div>
              <% end %>
            </dd>
          </div>
        <% end %>
      </dl>
    </div>
  </div>
</div>
