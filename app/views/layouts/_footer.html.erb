<footer>
  <div class="container mx-auto p-4 text-sm text-gray-500 flex flex-col lg:flex-row lg:justify-between lg:items-center relative z-10">
    <p>&copy; <%= Time.current.year %> West Baton Rouge Presbyterian Church. All rights reserved.</p>
    <nav aria-label="Footer navigation" class="mt-2">
      <ul>
        <% if authenticated? %>
          <li><%= link_to "Log Out", session_path, data: { turbo_method: :delete } %></li>
        <% else %>
          <li><%= link_to "Sign in", new_session_path %></li>
        <% end %>
      </ul>
    </nav>
  </div>
</footer>
