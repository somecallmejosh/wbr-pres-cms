<%# Consistent save / cancel footer for admin forms.
  locals:
    form:        the form builder (required)
    label:       submit button text (required)
    cancel_path: where the Cancel link goes (required)
    cancel_data: optional data-attributes hash for the Cancel link (e.g. modal close)
%>
<% cancel_data = local_assigns.fetch(:cancel_data, {}) %>
<div class="mt-8 flex flex-col-reverse gap-3 border-t border-stone-200 pt-6 sm:flex-row sm:items-center sm:justify-end">
  <% if cancel_data.present? %>
    <%# JS-driven cancel (e.g. modal close) — a real button avoids any link/Turbo navigation. %>
    <%= button_tag "Cancel", type: "button", data: cancel_data, class: "btn-ghost w-full sm:w-auto" %>
  <% else %>
    <%= link_to "Cancel", cancel_path, class: "btn-ghost w-full sm:w-auto" %>
  <% end %>
  <%= form.submit label, class: "btn-primary w-full sm:w-auto" %>
</div>
