<% content_for :title, "West Baton Rouge Presbyterian Church" %>

<%# Hero Section %>
<section class="relative w-full min-h-[420px] flex items-center justify-center overflow-hidden bg-stone-800">
  <img
    src="https://res.cloudinary.com/dwjulenau/image/upload/v1/wbr-pres-cms/image012?_a=BACJ3SDL"
    alt=""
    aria-hidden="true"
    class="absolute inset-0 w-full h-full object-cover opacity-30"
  >
  <div class="relative z-10 text-center px-4 py-16 max-w-3xl mx-auto">
    <h1 class="font-marcellus text-4xl md:text-5xl lg:text-6xl text-white leading-tight mb-4 text-balance">
      Welcome to West Baton Rouge<br>Presbyterian Church
    </h1>
    <p class="text-stone-200 text-lg md:text-xl mb-8">Rooted in faith. Growing together.</p>
    <%= link_to "Learn About Our Church", pages_about_path, class: "inline-block bg-amber-700 hover:bg-amber-600 text-white font-semibold px-8 py-3 rounded-md transition-colors text-base" %>
  </div>
</section>

<%# Main Content %>
<div class="container mx-auto px-4 py-10">
  <section class="mb-12">
    <div class="flex items-end gap-4 mb-6">
      <h2 class="font-marcellus text-2xl text-stone-900 border-b-2 border-amber-500 pb-1">This Week's Events</h2>
    </div>

    <% if @weekly_events.any? %>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <% @weekly_events.each do |event| %>
          <%= render "events/event_card", event: event %>
        <% end %>
      </div>
    <% else %>
      <p class="text-stone-600">No events scheduled this week.</p>
    <% end %>

    <div class="mt-6">
      <%= link_to "View All Events &rarr;".html_safe, events_path, class: "text-amber-700 hover:text-amber-800 font-medium transition-colors" %>
    </div>
  </section>

  <section>
    <h2 class="font-marcellus text-2xl text-stone-900 border-b-2 border-amber-500 pb-1 mb-6">
      <%= Date.current.strftime("%B") %> Birthdays
    </h2>

    <% if @birthdays.any? %>
      <ul class="divide-y divide-stone-200 max-w-lg">
        <% @birthdays.each do |member| %>
          <li class="py-3 flex justify-between items-center">
            <span class="font-medium text-stone-800"><%= member.full_name %></span>
            <span class="text-stone-600 text-sm"><%= member.birthday_display %></span>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="text-stone-600">No birthdays this month.</p>
    <% end %>
  </section>
</div>
