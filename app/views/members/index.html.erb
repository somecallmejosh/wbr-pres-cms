<div class="container mx-auto px-4 py-8">
  <div class="flex items-center justify-between mb-6">
    <h1 class="font-marcellus text-4xl text-stone-900">Members</h1>
    <%= link_to "New Member", new_member_path, class: "rounded-md px-4 py-2 bg-stone-700 hover:bg-stone-600 text-white font-medium transition-colors" %>
  </div>

  <% if @members.any? %>
    <div class="overflow-x-auto rounded-lg border border-stone-200">
      <table class="w-full text-left">
        <thead>
          <tr class="bg-stone-800 text-white">
            <th class="py-3 px-4 font-semibold">Name</th>
            <th class="py-3 px-4 font-semibold hidden sm:table-cell">Email</th>
            <th class="py-3 px-4 font-semibold hidden md:table-cell">Phone</th>
            <th class="py-3 px-4 font-semibold hidden lg:table-cell">Birthday</th>
            <th class="py-3 px-4 font-semibold">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% @members.each do |member| %>
            <%= render "members/member_row", member: member %>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p class="text-stone-600">No members have been added yet.</p>
  <% end %>
</div>
