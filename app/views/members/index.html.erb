<% content_for :title, "Members — Admin" %>

<%= render "shared/page_header",
      eyebrow: "Member Directory",
      title: "Members",
      subtitle: "The private church directory. #{pluralize(@members.size, 'person')} listed.",
      action: link_to(new_member_path, class: "btn-primary") {
        '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg> New Member'.html_safe
      } %>

<div class="container mx-auto px-4 py-10 md:py-14">
  <% if @members.any? %>
    <div data-controller="bulk-select">
      <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
        <span class="text-sm text-stone-500" data-bulk-select-target="count">None selected</span>
        <div class="flex items-center gap-2">
          <%= button_to "Delete all members", destroy_all_members_path, method: :delete,
                class: "btn-danger",
                form: { class: "hidden", data: { bulk_select_target: "deleteAll" } },
                data: { turbo_confirm: "Delete ALL #{pluralize(@members.size, 'member')}? This cannot be undone." } %>
          <button type="submit" form="members_bulk_delete"
                  class="btn-danger hidden"
                  data-bulk-select-target="submit"
                  data-turbo-confirm="Delete the selected members? This cannot be undone.">
            Delete selected
          </button>
        </div>
      </div>

      <%= form_with url: bulk_destroy_members_path, method: :delete, id: "members_bulk_delete" do %>
        <div class="admin-shell" data-controller="reveal">
          <div class="admin-core overflow-hidden">
            <div class="overflow-x-auto">
              <table class="w-full text-left">
                <thead>
                  <tr class="border-b border-stone-200 bg-stone-50/80">
                    <th class="w-px px-6 py-4">
                      <%= check_box_tag "select_all", "1", false,
                            class: "size-4 cursor-pointer rounded border-stone-300 text-amber-600 focus:ring-amber-500",
                            aria: { label: "Select all members" },
                            data: { bulk_select_target: "selectAll", action: "change->bulk-select#toggleAll" } %>
                    </th>
                    <th class="px-6 py-4 text-xs font-semibold uppercase tracking-[0.12em] text-stone-500">Name</th>
                    <th class="hidden px-6 py-4 text-xs font-semibold uppercase tracking-[0.12em] text-stone-500 sm:table-cell">Email</th>
                    <th class="hidden px-6 py-4 text-xs font-semibold uppercase tracking-[0.12em] text-stone-500 md:table-cell">Phone</th>
                    <th class="hidden px-6 py-4 text-xs font-semibold uppercase tracking-[0.12em] text-stone-500 lg:table-cell">Birthday</th>
                    <th class="px-6 py-4 text-right text-xs font-semibold uppercase tracking-[0.12em] text-stone-500">Actions</th>
                  </tr>
                </thead>
                <tbody>
                  <% @members.each do |member| %>
                    <%= render "members/member_row", member: member %>
                  <% end %>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="admin-shell mx-auto max-w-xl" data-controller="reveal">
      <div class="admin-core flex flex-col items-center gap-4 px-6 py-16 text-center">
        <div class="flex size-14 items-center justify-center rounded-2xl bg-amber-100 text-amber-700">
          <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/><line x1="19" y1="8" x2="19" y2="14"/><line x1="16" y1="11" x2="22" y2="11"/></svg>
        </div>
        <div>
          <p class="font-marcellus text-xl text-stone-900">No members yet</p>
          <p class="mt-1 text-sm text-stone-500">Add the first person to the church directory.</p>
        </div>
        <%= link_to "Add your first member", new_member_path, class: "btn-primary mt-2" %>
      </div>
    </div>
  <% end %>
</div>
