<%#
  New-event modal, loaded into the calendar's "modal" Turbo Frame.
  The <dialog> is opened/closed by modal_controller; the form posts back the
  caller's calendar view (month/year/category) so create can refresh the grid.
%>
<dialog data-controller="modal"
        aria-labelledby="event-modal-title"
        class="m-auto w-full max-w-2xl bg-transparent p-0 backdrop:bg-stone-900/40 backdrop:backdrop-blur-sm">
  <div class="relative max-h-[90vh] overflow-y-auto rounded-[1.75rem] bg-white shadow-[0_40px_90px_-30px_rgba(68,64,60,0.6)] ring-1 ring-stone-900/10 transition-opacity duration-300 ease-fluid opacity-100 starting:opacity-0">

    <div class="sticky top-0 z-10 flex items-start justify-between gap-4 border-b border-stone-100 bg-white/95 px-6 py-5 backdrop-blur sm:px-8">
      <div>
        <span class="eyebrow">Calendar</span>
        <h2 id="event-modal-title" class="font-marcellus mt-3 text-2xl text-stone-900">Add a new event</h2>
        <% if @event.event_date.present? %>
          <p class="mt-1 text-sm text-stone-500"><%= full_date_ordinal(@event.event_date) %></p>
        <% end %>
      </div>
      <button type="button" data-action="modal#close" aria-label="Close"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full text-stone-400 ring-1 ring-stone-900/5 transition-colors duration-300 hover:bg-stone-100 hover:text-stone-700 focus:outline-none focus-visible:ring-2 focus-visible:ring-amber-500">
        <%= line_icon(%(<path d="M6 6l12 12"/><path d="M18 6 6 18"/>), css: "h-5 w-5") %>
      </button>
    </div>

    <div class="px-6 py-6 sm:px-8">
      <%= render "events/form",
            event: @event,
            bare: true,
            cancel_path: calendar_path(@calendar_context.compact_blank),
            cancel_data: { action: "modal#close" },
            calendar_context: @calendar_context %>
    </div>
  </div>
</dialog>
