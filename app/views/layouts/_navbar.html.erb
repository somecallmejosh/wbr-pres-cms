<a href="#main-content" class="absolute -top-full focus:top-0 focus:left-0 bg-amber-700 text-white px-4 py-2 z-50">Skip to main content</a>
<header class="sticky top-0 z-50 bg-stone-100">
  <nav aria-label="Main navigation" class="px-4">
    <div class="container mx-auto flex items-center justify-between py-3 lg:py-6">
      <div class="flex items-center gap-3">
        <img src="https://res.cloudinary.com/dwjulenau/image/upload/v1765035098/WBR%20Presbyterian/logo.png" alt="Logo" class="size-14">
        <a href="/" class="font-marcellus text-xl text-stone-900 leading-tight hover:text-amber-700 transition-colors">
          West Baton Rouge<br>
          <span class="text-amber-700">Presbyterian Church</span>
        </a>
      </div>
      <div>
        <%
          base_lnk   = "px-3 py-2 text-sm font-medium transition-colors rounded-md"
          active_lnk = "#{base_lnk} text-amber-700 underline underline-offset-4 decoration-2 decoration-amber-600"
          idle_lnk   = "#{base_lnk} text-stone-600 hover:text-stone-900 hover:bg-stone-200"
        %>
        <ul class="hidden lg:flex items-center space-x-0.5">
          <li>
            <%= link_to "Home", root_path, class: current_page?(root_path) ? active_lnk : idle_lnk %>
          </li>
          <li><%= link_to "Events", events_path, class: controller_name == "events" ? active_lnk : idle_lnk %></li>
          <li><%= link_to "Calendar", calendar_path, class: controller_name == "calendar" ? active_lnk : idle_lnk %></li>
          <li><%= link_to "Galleries", galleries_path, class: controller_name == "galleries" ? active_lnk : idle_lnk %></li>
          <li><%= link_to "About", pages_about_path, class: current_page?(pages_about_path) ? active_lnk : idle_lnk %></li>
          <li><%= link_to "Contact", pages_contact_path, class: current_page?(pages_contact_path) ? active_lnk : idle_lnk %></li>
          <% if authenticated? %>
            <li class="border-l border-stone-300 pl-2 ml-1">
              <%= link_to "Members", members_path, class: controller_name == "members" ? active_lnk : idle_lnk %>
            </li>
            <li><%= link_to "Image Library", admin_images_path, class: params[:controller] == "admin/images" ? active_lnk : idle_lnk %></li>
          <% end %>
        </ul>
        <button @click="menuOpen = !menuOpen" aria-label="Toggle menu" class="ml-4 lg:hidden text-stone-700 p-1 hover:bg-stone-200 rounded-md transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path fill="currentColor" d="M3 18v-2h18v2zm0-5v-2h18v2zm0-5V6h18v2z"/></svg>
        </button>
      </div>
    </div>
  </nav>
</header>
<div x-show="menuOpen" x-transition.scale.origin.top @click.away="menuOpen = false" class="bg-stone-100 shadow-md lg:hidden border-t border-stone-200">
  <div class="container mx-auto px-4 py-2">
    <ul class="divide-y divide-stone-200">
      <li>
        <%= link_to "Home", root_path, class: "block py-3 text-sm font-medium #{current_page?(root_path) ? 'text-amber-700 font-semibold' : 'text-stone-600 hover:text-stone-900'} transition-colors" %>
      </li>
      <li><%= link_to "Events", events_path, class: "block py-3 text-sm font-medium #{controller_name == 'events' ? 'text-amber-700 font-semibold' : 'text-stone-600 hover:text-stone-900'} transition-colors" %></li>
      <li><%= link_to "Calendar", calendar_path, class: "block py-3 text-sm font-medium #{controller_name == 'calendar' ? 'text-amber-700 font-semibold' : 'text-stone-600 hover:text-stone-900'} transition-colors" %></li>
      <li><%= link_to "Galleries", galleries_path, class: "block py-3 text-sm font-medium #{controller_name == 'galleries' ? 'text-amber-700 font-semibold' : 'text-stone-600 hover:text-stone-900'} transition-colors" %></li>
      <li><%= link_to "About", pages_about_path, class: "block py-3 text-sm font-medium #{current_page?(pages_about_path) ? 'text-amber-700 font-semibold' : 'text-stone-600 hover:text-stone-900'} transition-colors" %></li>
      <li><%= link_to "Contact", pages_contact_path, class: "block py-3 text-sm font-medium #{current_page?(pages_contact_path) ? 'text-amber-700 font-semibold' : 'text-stone-600 hover:text-stone-900'} transition-colors" %></li>
      <% if authenticated? %>
        <li><%= link_to "Members", members_path, class: "block py-3 text-sm font-medium #{controller_name == 'members' ? 'text-amber-700 font-semibold' : 'text-stone-600 hover:text-stone-900'} transition-colors" %></li>
        <li><%= link_to "Image Library", admin_images_path, class: "block py-3 text-sm font-medium #{params[:controller] == 'admin/images' ? 'text-amber-700 font-semibold' : 'text-stone-600 hover:text-stone-900'} transition-colors" %></li>
      <% end %>
    </ul>
  </div>
</div>
