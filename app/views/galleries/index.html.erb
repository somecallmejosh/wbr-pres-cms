<div class="container mx-auto p-4">
  <div class="flex items-center justify-between mb-6">
    <h1 class="font-bold text-4xl">Photo Galleries</h1>
    <% if authenticated? %>
      <%= link_to "New Gallery", new_gallery_path, class: "rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white font-medium" %>
    <% end %>
  </div>

  <% if @galleries.any? %>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <% @galleries.each do |gallery| %>
        <%= render "galleries/gallery_card", gallery: gallery %>
      <% end %>
    </div>
  <% else %>
    <p class="text-gray-500">No galleries available.</p>
  <% end %>
</div>
