<div class="border p-2 min-h-24 <%= day == Date.current ? 'bg-blue-50' : 'bg-white' %>">
  <span class="font-semibold text-sm"><%= day.day %></span>
  <% events.each do |event| %>
    <%= link_to event.title, event_path(event),
        class: "block text-xs truncate text-blue-700 hover:underline mt-0.5",
        data: { turbo_frame: "_top" } %>
  <% end %>
</div>
