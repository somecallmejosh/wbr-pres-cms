<div
        x-dialog
        x-model="open"
        x-cloak
        class="fixed inset-0 overflow-hidden z-[100] lg:hidden">
        <!-- Overlay -->
        <div x-dialog:overlay x-transition.opacity class="fixed inset-0 bg-black/25"></div>

        <!-- Panel -->
        <div class="fixed inset-y-0 right-0 max-w-lg w-full max-h-dvh min-h-dvh">
            <div
                x-dialog:panel
                x-transition:enter="transition ease-out duration-300"
                x-transition:enter-start="translate-x-full"
                x-transition:enter-end="translate-x-0"
                x-transition:leave="transition ease-in duration-300"
                x-transition:leave-start="translate-x-0"
                x-transition:leave-end="translate-x-full"
                class="h-full w-full">
                <div class="h-full flex flex-col bg-white shadow-lg overflow-y-auto p-8">
                    <!-- Close Button -->
                    <div class="absolute right-0 top-0 mr-4 mt-4">
                        <button type="button" @click="$dialog.close()" class="relative inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-md bg-transparent p-1.5 font-medium text-gray-400 hover:bg-gray-800/10 hover:text-gray-800 focus:outline-none focus:ring-2 focus:ring-stone-400">
                            <span class="sr-only">Close navigation menu</span>
                            <svg class="size-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                                <path d="M6.28 5.22a.75.75 0 0 0-1.06 1.06L8.94 10l-3.72 3.72a.75.75 0 1 0 1.06 1.06L10 11.06l3.72 3.72a.75.75 0 1 0 1.06-1.06L11.06 10l3.72-3.72a.75.75 0 0 0-1.06-1.06L10 8.94 6.28 5.22Z"></path>
                            </svg>
                        </button>
                    </div>

                    <!-- Body -->
                    <div class="space-y-6">
                          <div class="flex items-center gap-3">
        <img src="<%= cloudinary_image("WBR Presbyterian/logo", crop: :limit, width: 112) %>" alt="" aria-hidden="true" class="size-14">
        <a href="/" class="font-marcellus lg:text-xl text-stone-900 leading-tight hover:text-amber-700 transition-colors">
          West Baton Rouge<br>
          <span class="text-amber-700">Presbyterian Church</span>
        </a>
      </div>
                            <ul class="divide-y divide-stone-200">
      <li>
        <%= link_to "Home", root_path, class: "block py-3 text-sm font-medium #{current_page?(root_path) ? 'text-amber-700 font-semibold' : 'text-stone-600 hover:text-stone-900'} transition-colors", aria: { current: current_page?(root_path) ? "page" : false } %>
      </li>
      <li><%= link_to "Events", events_path, class: "block py-3 text-sm font-medium #{controller_name == 'events' ? 'text-amber-700 font-semibold' : 'text-stone-600 hover:text-stone-900'} transition-colors", aria: { current: controller_name == "events" ? "page" : false } %></li>
      <li><%= link_to "Calendar", calendar_path, class: "block py-3 text-sm font-medium #{controller_name == 'calendar' ? 'text-amber-700 font-semibold' : 'text-stone-600 hover:text-stone-900'} transition-colors", aria: { current: controller_name == "calendar" ? "page" : false } %></li>
      <li><%= link_to "Galleries", galleries_path, class: "block py-3 text-sm font-medium #{controller_name == 'galleries' ? 'text-amber-700 font-semibold' : 'text-stone-600 hover:text-stone-900'} transition-colors", aria: { current: controller_name == "galleries" ? "page" : false } %></li>
      <li><%= link_to "About", pages_about_path, class: "block py-3 text-sm font-medium #{current_page?(pages_about_path) ? 'text-amber-700 font-semibold' : 'text-stone-600 hover:text-stone-900'} transition-colors", aria: { current: current_page?(pages_about_path) ? "page" : false } %></li>
      <li><%= link_to "Contact", pages_contact_path, class: "block py-3 text-sm font-medium #{current_page?(pages_contact_path) ? 'text-amber-700 font-semibold' : 'text-stone-600 hover:text-stone-900'} transition-colors", aria: { current: current_page?(pages_contact_path) ? "page" : false } %></li>
      <% if authenticated? %>
        <li><%= link_to "Dashboard", dashboard_path, class: "block py-3 text-sm font-medium #{current_page?(dashboard_path) ? 'text-amber-700 font-semibold' : 'text-stone-600 hover:text-stone-900'} transition-colors", aria: { current: current_page?(dashboard_path) ? "page" : false } %></li>
      <% end %>
    </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
