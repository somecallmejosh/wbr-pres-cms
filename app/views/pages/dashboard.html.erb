<% content_for :title, "Admin Dashboard — West Baton Rouge Presbyterian Church" %>

<%
  hour = Time.current.hour
  greeting = if hour < 12 then "Good morning"
             elsif hour < 17 then "Good afternoon"
             else "Good evening" end

  stats = [
    { count: @upcoming_events, label: "Upcoming events", href: events_path, accent: "amber",
      icon: '<rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>' },
    { count: @gallery_count, label: "Photo galleries", href: galleries_path, accent: "rose",
      icon: '<rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/>' },
    { count: @member_count, label: "Members", href: members_path, accent: "emerald",
      icon: '<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>' },
    { count: @photo_count, label: "Photos in library", href: admin_images_path, accent: "sky",
      icon: '<rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/>' }
  ]
  accent_classes = {
    "amber"   => "bg-amber-100 text-amber-700",
    "rose"    => "bg-rose-100 text-rose-700",
    "emerald" => "bg-emerald-100 text-emerald-700",
    "sky"     => "bg-sky-100 text-sky-700"
  }
%>

<div class="container mx-auto max-w-5xl px-4 py-12 md:py-16">

  <%# ── Welcome band ──────────────────────────────────────────────────── %>
  <header class="mb-12" data-controller="reveal">
    <span class="eyebrow">Admin Dashboard</span>
    <h1 class="font-marcellus mt-5 text-4xl leading-[1.1] text-stone-900 md:text-5xl text-balance">
      <%= greeting %>. What would you like to do?
    </h1>
    <p class="mt-4 text-lg text-stone-500"><%= Date.current.strftime("%A, %B %-d, %Y") %></p>
  </header>

  <%# ── At a glance ───────────────────────────────────────────────────── %>
  <section class="mb-14" aria-labelledby="glance-heading" data-controller="reveal" data-reveal-delay-value="80">
    <h2 id="glance-heading" class="sr-only">At a glance</h2>
    <div class="grid grid-cols-2 gap-4 lg:grid-cols-4">
      <% stats.each do |stat| %>
        <%= link_to stat[:href], class: "admin-shell group block transition duration-500 hover:-translate-y-1 hover:shadow-[0_28px_60px_-28px_rgba(68,64,60,0.45)] [transition-timing-function:var(--ease-fluid)]" do %>
          <div class="admin-core flex flex-col gap-3 p-5">
            <div class="flex size-10 items-center justify-center rounded-xl <%= accent_classes[stat[:accent]] %>">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><%= stat[:icon].html_safe %></svg>
            </div>
            <div>
              <p class="font-marcellus text-4xl leading-none text-stone-900"><%= stat[:count] %></p>
              <p class="mt-1.5 text-sm text-stone-500"><%= stat[:label] %></p>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>
  </section>

  <%# ── Create New ────────────────────────────────────────────────────── %>
  <section class="mb-14" aria-labelledby="actions-heading" data-controller="reveal" data-reveal-delay-value="120">
    <h2 id="actions-heading" class="mb-5 text-xs font-semibold uppercase tracking-[0.2em] text-stone-400">Create something new</h2>
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">

      <%# New Event %>
      <%= link_to new_event_path, class: "admin-shell group block transition duration-500 hover:-translate-y-1 hover:shadow-[0_28px_60px_-28px_rgba(68,64,60,0.45)] [transition-timing-function:var(--ease-fluid)]" do %>
        <div class="admin-core flex items-start gap-5 p-6">
          <div class="flex size-12 shrink-0 items-center justify-center rounded-2xl bg-amber-100 text-amber-700 transition-colors group-hover:bg-amber-200">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/><line x1="12" y1="14" x2="12" y2="18"/><line x1="10" y1="16" x2="14" y2="16"/></svg>
          </div>
          <div class="flex-1">
            <p class="font-marcellus text-xl text-stone-900">New Event</p>
            <p class="mt-1 text-sm leading-relaxed text-stone-500">Add a service, meeting, or community event to the calendar.</p>
          </div>
          <span class="mt-1 flex size-8 shrink-0 items-center justify-center rounded-full bg-stone-100 text-stone-500 transition-all group-hover:bg-amber-700 group-hover:text-white group-hover:translate-x-0.5 group-hover:-translate-y-0.5" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </span>
        </div>
      <% end %>

      <%# New Gallery %>
      <%= link_to new_gallery_path, class: "admin-shell group block transition duration-500 hover:-translate-y-1 hover:shadow-[0_28px_60px_-28px_rgba(68,64,60,0.45)] [transition-timing-function:var(--ease-fluid)]" do %>
        <div class="admin-core flex items-start gap-5 p-6">
          <div class="flex size-12 shrink-0 items-center justify-center rounded-2xl bg-amber-100 text-amber-700 transition-colors group-hover:bg-amber-200">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
          </div>
          <div class="flex-1">
            <p class="font-marcellus text-xl text-stone-900">New Photo Gallery</p>
            <p class="mt-1 text-sm leading-relaxed text-stone-500">Create a photo album and choose which pictures to include.</p>
          </div>
          <span class="mt-1 flex size-8 shrink-0 items-center justify-center rounded-full bg-stone-100 text-stone-500 transition-all group-hover:bg-amber-700 group-hover:text-white group-hover:translate-x-0.5 group-hover:-translate-y-0.5" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </span>
        </div>
      <% end %>

      <%# New Member %>
      <%= link_to new_member_path, class: "admin-shell group block transition duration-500 hover:-translate-y-1 hover:shadow-[0_28px_60px_-28px_rgba(68,64,60,0.45)] [transition-timing-function:var(--ease-fluid)]" do %>
        <div class="admin-core flex items-start gap-5 p-6">
          <div class="flex size-12 shrink-0 items-center justify-center rounded-2xl bg-amber-100 text-amber-700 transition-colors group-hover:bg-amber-200">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/><line x1="19" y1="8" x2="19" y2="14"/><line x1="16" y1="11" x2="22" y2="11"/></svg>
          </div>
          <div class="flex-1">
            <p class="font-marcellus text-xl text-stone-900">New Member</p>
            <p class="mt-1 text-sm leading-relaxed text-stone-500">Add someone to the private church member directory.</p>
          </div>
          <span class="mt-1 flex size-8 shrink-0 items-center justify-center rounded-full bg-stone-100 text-stone-500 transition-all group-hover:bg-amber-700 group-hover:text-white group-hover:translate-x-0.5 group-hover:-translate-y-0.5" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </span>
        </div>
      <% end %>

      <%# Upload Photos %>
      <%= link_to new_admin_image_path, class: "admin-shell group block transition duration-500 hover:-translate-y-1 hover:shadow-[0_28px_60px_-28px_rgba(68,64,60,0.45)] [transition-timing-function:var(--ease-fluid)]" do %>
        <div class="admin-core flex items-start gap-5 p-6">
          <div class="flex size-12 shrink-0 items-center justify-center rounded-2xl bg-amber-100 text-amber-700 transition-colors group-hover:bg-amber-200">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="16 16 12 12 8 16"/><line x1="12" y1="12" x2="12" y2="21"/><path d="M20.39 18.39A5 5 0 0 0 18 9h-1.26A8 8 0 1 0 3 16.3"/></svg>
          </div>
          <div class="flex-1">
            <p class="font-marcellus text-xl text-stone-900">Upload Photos</p>
            <p class="mt-1 text-sm leading-relaxed text-stone-500">Add new photos to the library to use in events and galleries.</p>
          </div>
          <span class="mt-1 flex size-8 shrink-0 items-center justify-center rounded-full bg-stone-100 text-stone-500 transition-all group-hover:bg-amber-700 group-hover:text-white group-hover:translate-x-0.5 group-hover:-translate-y-0.5" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </span>
        </div>
      <% end %>

    </div>
  </section>

  <%# ── Manage ────────────────────────────────────────────────────────── %>
  <section class="mb-14" aria-labelledby="manage-heading" data-controller="reveal" data-reveal-delay-value="160">
    <h2 id="manage-heading" class="mb-5 text-xs font-semibold uppercase tracking-[0.2em] text-stone-400">Manage what's already here</h2>
    <div class="grid grid-cols-1 gap-3">

      <% [
        { href: events_path, title: "All Events", desc: "View, edit, or delete existing events", icon: '<rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>' },
        { href: galleries_path, title: "All Photo Galleries", desc: "View, edit, or delete existing galleries", icon: '<rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/>' },
        { href: members_path, title: "All Members", desc: "View, edit, or remove member records", icon: '<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>' },
        { href: admin_images_path, title: "Image Library", desc: "Browse, upload, or remove photos", icon: '<rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/>' }
      ].each do |item| %>
        <%= link_to item[:href], class: "group flex items-center gap-4 rounded-2xl bg-white px-5 py-4 ring-1 ring-stone-900/5 shadow-sm transition duration-500 hover:-translate-y-0.5 hover:ring-amber-300/60 hover:shadow-[0_18px_40px_-24px_rgba(68,64,60,0.4)] [transition-timing-function:var(--ease-fluid)]" do %>
          <div class="flex size-10 shrink-0 items-center justify-center rounded-xl bg-stone-100 text-stone-500 transition-colors group-hover:bg-amber-100 group-hover:text-amber-700">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><%= item[:icon].html_safe %></svg>
          </div>
          <div class="min-w-0 flex-1">
            <p class="font-semibold text-stone-900 group-hover:text-amber-700"><%= item[:title] %></p>
            <p class="truncate text-sm text-stone-500"><%= item[:desc] %></p>
          </div>
          <span class="shrink-0 text-stone-300 transition-all group-hover:translate-x-1 group-hover:text-amber-600" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </span>
        <% end %>
      <% end %>

    </div>
  </section>

  <%# ── Help ──────────────────────────────────────────────────────────── %>
  <section aria-labelledby="help-heading" data-controller="reveal" data-reveal-delay-value="200">
    <h2 id="help-heading" class="mb-5 text-xs font-semibold uppercase tracking-[0.2em] text-stone-400">Need a hand?</h2>
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">

      <%= link_to admin_guide_path, class: "group flex items-start gap-4 rounded-2xl bg-stone-50 p-5 ring-1 ring-stone-900/5 transition duration-500 hover:bg-white hover:shadow-[0_18px_40px_-24px_rgba(68,64,60,0.4)] [transition-timing-function:var(--ease-fluid)]" do %>
        <div class="flex size-10 shrink-0 items-center justify-center rounded-xl bg-stone-200/70 text-stone-600">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
        </div>
        <div>
          <p class="font-semibold text-stone-900">User Manual</p>
          <p class="mt-1 text-sm leading-relaxed text-stone-500">Step-by-step instructions for managing events, galleries, members, and photos.</p>
        </div>
      <% end %>

      <%= link_to specifications_path, class: "group flex items-start gap-4 rounded-2xl bg-stone-50 p-5 ring-1 ring-stone-900/5 transition duration-500 hover:bg-white hover:shadow-[0_18px_40px_-24px_rgba(68,64,60,0.4)] [transition-timing-function:var(--ease-fluid)]" do %>
        <div class="flex size-10 shrink-0 items-center justify-center rounded-xl bg-stone-200/70 text-stone-600">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
        </div>
        <div>
          <p class="font-semibold text-stone-900">Technical Specifications</p>
          <p class="mt-1 text-sm leading-relaxed text-stone-500">Full technical documentation covering architecture, data models, and deployment.</p>
        </div>
      <% end %>

    </div>
  </section>

</div>
