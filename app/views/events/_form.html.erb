<%#
  locals:
    event:            the Event (required)
    bare:             skip the admin-shell/admin-core double-bezel wrapper (modal use)
    cancel_path:      where Cancel goes (default events_path)
    cancel_data:      optional data-attributes for Cancel (e.g. modal close)
    calendar_context: { month:, year:, category: } — when present, posts the
                      caller's calendar view back so create can refresh it
%>
<%
  bare             = local_assigns.fetch(:bare, false)
  cancel_path      = local_assigns.fetch(:cancel_path, events_path)
  cancel_data      = local_assigns.fetch(:cancel_data, {})
  calendar_context = local_assigns[:calendar_context]
%>
<%= form_with model: event do |form| %>
  <%= render "shared/form_errors", record: event %>

  <% if calendar_context %>
    <%= hidden_field_tag :cal_month, calendar_context[:month] %>
    <%= hidden_field_tag :cal_year, calendar_context[:year] %>
    <%= hidden_field_tag :cal_category, calendar_context[:category] %>
  <% end %>

  <%= content_tag :div, class: ("admin-shell" unless bare) do %>
    <%= content_tag :div, class: (bare ? "" : "admin-core p-6 sm:p-8") do %>

      <section>
        <h2 class="font-marcellus text-xl text-stone-900">Event details</h2>
        <p class="mt-1 text-sm text-stone-500">Title, date, and category are required.</p>

        <div class="mt-5 grid grid-cols-1 gap-5">
          <div>
            <%= form.label :title, class: "field-label" %>
            <%= form.text_field :title, required: true, class: "field-input" %>
          </div>

          <div>
            <%= form.label :description, class: "field-label" %>
            <%= form.text_area :description, rows: 4, class: "field-input resize-y" %>
            <p class="field-hint">A short summary shown on the event page.</p>
          </div>

          <div class="grid grid-cols-1 gap-5 sm:grid-cols-3">
            <div>
              <%= form.label :event_date, "Date", class: "field-label" %>
              <%= form.date_field :event_date, required: true, class: "field-input" %>
            </div>

            <div>
              <%= form.label :start_time, "Start time", class: "field-label" %>
              <%= form.time_field :start_time, required: true, class: "field-input" %>
            </div>

            <div>
              <%= form.label :end_time, "End time", class: "field-label" %>
              <%= form.time_field :end_time, class: "field-input" %>
            </div>
          </div>

          <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
            <div>
              <%= form.label :location, class: "field-label" %>
              <%= form.text_field :location, class: "field-input" %>
            </div>

            <div>
              <%= form.label :category, class: "field-label" %>
              <%= form.select :category, Event::CATEGORY_LABELS.map { |value, label| [label, value] }, { include_blank: "Select a category" }, required: true, class: "field-input" %>
            </div>
          </div>
        </div>
      </section>

      <%
        selected_image = event.image
        picker_data = { controller: "event-image" }
        picker_data[:event_image_update_url_value] = image_event_path(event) if event.persisted?
      %>
      <hr class="my-8 border-stone-200">

      <%= content_tag :section, data: picker_data do %>
          <div class="flex items-start justify-between gap-4">
            <div>
              <h2 class="font-marcellus text-xl text-stone-900">Event photo</h2>
              <p class="mt-1 text-sm text-stone-500">This is the image featured on the event. Tap any photo below to change it<%= event.persisted? ? " — it saves instantly." : "." %></p>
            </div>
            <% if event.persisted? %>
              <span data-event-image-target="status"
                    class="inline-flex shrink-0 items-center gap-1.5 rounded-full bg-emerald-600/10 px-3 py-1 text-xs font-medium text-emerald-700 opacity-0 transition-opacity duration-500 ease-[cubic-bezier(0.32,0.72,0,1)]"
                    aria-live="polite">
                <svg viewBox="0 0 20 20" fill="currentColor" class="size-3.5"><path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z" clip-rule="evenodd" /></svg>
                Saved
              </span>
            <% end %>
          </div>

          <%# Hero preview — the current selection, impossible to miss. %>
          <div class="admin-shell mt-5 !p-2">
            <div class="admin-core relative aspect-[16/9] overflow-hidden rounded-[1rem] bg-stone-100">
              <img data-event-image-target="image"
                   src="<%= selected_image&.display_url(width: 1200) %>"
                   alt="<%= selected_image&.alt_text.presence || selected_image&.title.presence || "" %>"
                   class="<%= "hidden" unless selected_image %> h-full w-full object-cover">

              <div data-event-image-target="placeholder"
                   class="<%= "hidden" if selected_image %> absolute inset-0 flex flex-col items-center justify-center gap-3 text-stone-400">
                <svg xmlns="http://www.w3.org/2000/svg" class="size-12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>
                <p class="text-sm font-medium">No photo selected</p>
              </div>

              <%# Caption ribbon — names what's featured. %>
              <div class="pointer-events-none absolute inset-x-0 bottom-0 flex items-center gap-2 bg-gradient-to-t from-stone-950/70 to-transparent px-4 pb-3 pt-10">
                <svg xmlns="http://www.w3.org/2000/svg" class="size-3.5 shrink-0 text-amber-300" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="m12 17.27 6.18 3.73-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
                <span data-event-image-target="caption" class="truncate text-[11px] font-medium uppercase tracking-[0.18em] text-white">
                  <%= selected_image ? (selected_image.title.presence || "Featured on this event") : "No photo selected" %>
                </span>
              </div>
            </div>
          </div>

          <%# Library picker — always visible so changing is obvious. %>
          <div class="mt-6">
            <div class="flex items-baseline justify-between gap-3">
              <div class="flex items-baseline gap-2">
                <%= form.label :image_id, "Choose a photo", class: "field-label !mb-0" %>
                <span class="text-xs text-stone-400"><%= @images.any? ? "#{pluralize(@images.size, "photo")} available" : "Library is empty" %></span>
              </div>
              <%= link_to new_admin_image_path, data: { turbo_frame: "upload_modal" }, class: "group inline-flex shrink-0 items-center gap-1.5 text-xs font-medium text-amber-700 transition-colors hover:text-amber-800" do %>
                <svg xmlns="http://www.w3.org/2000/svg" class="size-3.5 transition-transform duration-300 ease-[cubic-bezier(0.32,0.72,0,1)] group-hover:-translate-y-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 17V3m0 0L7 8m5-5 5 5"/><path d="M5 17v2a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-2"/></svg>
                Upload a new photo
              <% end %>
            </div>

            <div class="mt-3 max-h-[360px] overflow-auto rounded-2xl bg-stone-50 p-4 ring-1 ring-stone-900/5">
              <div class="grid grid-cols-3 gap-3 sm:grid-cols-4 md:grid-cols-5">
                <label class="group relative cursor-pointer">
                  <%= form.radio_button :image_id, "", class: "sr-only peer", data: { action: "event-image#select" } %>
                  <div class="flex aspect-square flex-col items-center justify-center gap-1 rounded-xl border-2 border-dashed border-stone-300 bg-white text-center text-xs text-stone-400 transition-all duration-300 ease-[cubic-bezier(0.32,0.72,0,1)] group-hover:border-stone-400 peer-checked:border-solid peer-checked:border-amber-500 peer-checked:bg-amber-50 peer-checked:text-amber-700 peer-focus-visible:ring-2 peer-focus-visible:ring-amber-400">
                    <svg xmlns="http://www.w3.org/2000/svg" class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="m15 9-6 6m0-6 6 6"/></svg>
                    No photo
                  </div>
                </label>

                <%# `contents` lets streamed-in tiles join the grid directly. %>
                <div id="event-image-options" class="contents">
                  <% @images.each do |image| %>
                    <%= render "events/picker_tile", image: image, checked: event.image_id == image.id %>
                  <% end %>
                </div>
              </div>

              <% if @images.empty? %>
                <p class="px-1 py-6 text-center text-sm text-stone-500">
                  Your photo library is empty. <span class="font-medium text-stone-700">Upload a photo</span> and it'll be featured on this event automatically.
                </p>
              <% end %>
            </div>
          </div>
        <% end %>

      <%= render "shared/admin_action_bar", form: form, label: "Save event",
            cancel_path: cancel_path, cancel_data: cancel_data %>

    <% end %>
  <% end %>
<% end %>

<%# Lives outside the form element so its upload form isn't nested. The
    "Upload a new photo" link loads the upload dialog into this frame. %>
<%= turbo_frame_tag "upload_modal" %>
