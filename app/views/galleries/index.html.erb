<div class="container mx-auto px-4 py-8">
  <div class="flex items-center justify-between mb-6">
    <h1 class="font-marcellus text-4xl text-stone-900">Photo Galleries</h1>
    <% if authenticated? %>
      <%= link_to "New Gallery", new_gallery_path, class: "rounded-md px-4 py-2 bg-stone-700 hover:bg-stone-600 text-white font-medium transition-colors" %>
    <% end %>
  </div>

  <% if @galleries.any? %>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <% @galleries.each do |gallery| %>
        <%= render "galleries/gallery_card", gallery: gallery %>
      <% end %>
    </div>
  <% else %>
    <p class="text-stone-600">No galleries available.</p>
  <% end %>
</div>
