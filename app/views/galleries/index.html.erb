<% content_for :title, "Photo Galleries — West Baton Rouge Presbyterian Church" %>

<%= render "shared/page_header",
      eyebrow: "Moments Together",
      title: "Photo Galleries",
      subtitle: "Glimpses of worship, fellowship, and the life we share as a congregation.",
      action: (authenticated? ? link_to("New Gallery", new_gallery_path, class: "inline-flex items-center rounded-full bg-stone-800 px-5 py-2.5 font-medium text-white transition-all duration-500 ease-[cubic-bezier(0.32,0.72,0,1)] hover:bg-stone-700 active:scale-[0.98]") : nil) %>

<section class="relative overflow-hidden">
  <%# Ambient warmth bleeding up behind the grid. %>
  <div class="pointer-events-none absolute -left-24 top-32 h-80 w-80 rounded-full bg-amber-500/10 blur-3xl" aria-hidden="true"></div>
  <div class="pointer-events-none absolute -right-20 bottom-24 h-72 w-72 rounded-full bg-stone-400/10 blur-3xl" aria-hidden="true"></div>

  <div class="container relative mx-auto px-4 py-14 md:py-16">
    <%# Admin status filtering swaps just this frame (no full reload); turbo_action
        "advance" keeps the URL shareable and the Back button working. %>
    <%= turbo_frame_tag "galleries_list", data: { turbo_action: "advance" } do %>

      <% if authenticated? %>
        <div class="mb-10 flex flex-col gap-5 sm:flex-row sm:items-center sm:justify-between" data-controller="reveal">
          <p class="text-sm text-stone-500">
            Showing <span class="font-semibold text-stone-700"><%= pluralize(@galleries.size, "gallery") %></span>
          </p>
          <div class="-mx-4 flex gap-2 overflow-x-auto px-4 pb-1 [scrollbar-width:none] sm:mx-0 sm:flex-wrap sm:justify-end sm:overflow-visible sm:px-0 sm:pb-0" role="group" aria-label="Filter galleries by status">
            <% [ [ "All", nil ], [ "Published", "published" ], [ "Drafts", "drafts" ] ].each do |label, val| %>
              <% is_active = @filter == val %>
              <%= link_to label, galleries_path(filter: val), class: "shrink-0 rounded-full px-4 py-1.5 text-sm font-medium transition-all duration-300 ease-[cubic-bezier(0.32,0.72,0,1)] #{is_active ? 'bg-stone-900 text-white shadow-sm' : 'bg-white text-stone-600 ring-1 ring-stone-900/5 hover:bg-stone-100'}", aria: { current: is_active ? "true" : false } %>
            <% end %>
          </div>
        </div>
      <% end %>

      <% if @galleries.any? %>
        <div class="grid auto-rows-[14rem] grid-cols-1 gap-5 sm:grid-cols-2 sm:auto-rows-[15rem] lg:auto-rows-[16rem] lg:grid-cols-3">
          <% @galleries.each_with_index do |gallery, i| %>
            <%# First tile is the editorial hero — spans wide + tall on larger screens. %>
            <% featured = i.zero? %>
            <div data-controller="reveal" data-reveal-delay-value="<%= [ i * 70, 280 ].min %>"
                 class="<%= "sm:col-span-2 lg:col-span-2 lg:row-span-2" if featured %>">
              <%= render "galleries/gallery_card", gallery: gallery, featured: featured %>
            </div>
          <% end %>
        </div>
      <% else %>
        <% empty_heading, empty_body =
             case @filter
             when "published" then [ "No published galleries", "Publish a draft and it will appear here for visitors." ]
             when "drafts"    then [ "No draft galleries", "Galleries you're still working on will appear here." ]
             else [ "No galleries yet", "Photos from our gatherings will appear here soon." ]
             end %>
        <div class="mx-auto max-w-md rounded-[2rem] bg-white p-10 text-center shadow-[0_24px_60px_-30px_rgba(68,64,60,0.35)] ring-1 ring-stone-900/5">
          <div class="mx-auto mb-5 flex h-14 w-14 items-center justify-center rounded-full bg-amber-700/10 text-amber-700">
            <svg class="h-7 w-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="3" y="3" width="18" height="18" rx="2.5"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="m21 15-5-5L5 21"/>
            </svg>
          </div>
          <p class="font-marcellus text-xl text-stone-800"><%= empty_heading %></p>
          <p class="mt-2 text-stone-500"><%= empty_body %></p>
        </div>
      <% end %>
    <% end %>
  </div>
</section>
