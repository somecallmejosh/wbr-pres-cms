<% content_for :title, "Contact Us — West Baton Rouge Presbyterian Church" %>

<%# ===== Page Hero ===== %>
<section class="relative flex min-h-[360px] w-full items-center justify-center overflow-hidden bg-stone-900">
  <div class="absolute inset-0 opacity-20" style="background-image: url('/theme/church-pews%20(1).png'); background-size: cover; background-position: center;"></div>
  <div class="absolute inset-0 bg-gradient-to-t from-stone-900 via-stone-900/85 to-stone-900/60"></div>
  <img src="/theme/stainedglass%20(1).png" alt="" aria-hidden="true" class="pointer-events-none absolute -left-10 top-6 hidden w-40 -rotate-6 rounded-[1.5rem] opacity-20 blur-[1px] md:block">
  <img src="/theme/stainedglass2.webp" alt="" aria-hidden="true" class="pointer-events-none absolute -right-10 bottom-6 hidden w-40 rotate-6 rounded-[1.5rem] opacity-20 blur-[1px] md:block">
  <div class="relative z-10 px-4 py-20 text-center" data-controller="reveal">
    <span class="inline-block rounded-full bg-amber-500/15 px-4 py-1 text-[11px] font-medium uppercase tracking-[0.25em] text-amber-300">Reach Out</span>
    <h1 class="font-marcellus mt-6 text-4xl leading-[1.05] text-white md:text-5xl lg:text-6xl text-balance">We&rsquo;d love to hear<br class="hidden sm:block"> from you</h1>
    <div class="mx-auto mt-6 h-px w-20 bg-amber-500/60"></div>
    <p class="mx-auto mt-5 max-w-xl text-lg text-stone-300">Whether you&rsquo;re planning a first visit or simply have a question, there&rsquo;s a place for you here.</p>
  </div>
</section>

<div class="container mx-auto max-w-6xl px-4 py-20 md:py-28">

  <%# ===== Contact tiles — asymmetric bento ===== %>
  <section data-controller="reveal">
    <ul class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4">
      <% [
        ["Visit Us", "640 Florida Ave", "Port Allen, LA 70767", "https://www.google.com/maps/dir/?api=1&destination=640+Florida+Ave,+Port+Allen,+LA+70767",
          %(<path d="M12 21s-6-5.686-6-10a6 6 0 1 1 12 0c0 4.314-6 10-6 10Z"/><circle cx="12" cy="11" r="2.2"/>)],
        ["Call Us", "(225) 344-1486", "Mon–Fri, office hours", "tel:+12253441486",
          %(<path d="M5 4h3l1.5 5-2 1.5a12 12 0 0 0 6 6l1.5-2 5 1.5V20a1 1 0 0 1-1 1A16 16 0 0 1 4 5a1 1 0 0 1 1-1Z"/>)],
        ["Email Us", "office@wbrpres.org", "We reply within a few days", "mailto:office@wbrpres.org",
          %(<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3.5 7.5 8.5 6 8.5-6"/>)],
        ["Worship", "Sundays · 11:00 AM", "Bible Study · Wed 10:00 AM", nil,
          %(<circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/>)],
      ].each_with_index do |(label, line1, line2, href, icon), i| %>
        <li data-controller="reveal" data-reveal-delay-value="<%= i * 90 %>">
          <% tile_opts = { class: "group block h-full rounded-[1.75rem] bg-stone-50/60 p-1.5 ring-1 ring-stone-900/5 transition-all duration-500 ease-[cubic-bezier(0.32,0.72,0,1)] hover:-translate-y-1" } %>
          <% tile_opts[:href] = href if href %>
          <%= content_tag(href ? :a : :div, tile_opts) do %>
            <div class="h-full rounded-[calc(1.75rem-0.375rem)] bg-white p-6 shadow-[inset_0_1px_1px_rgba(255,255,255,0.7),0_16px_40px_-30px_rgba(68,64,60,0.45)] transition-shadow duration-500 ease-[cubic-bezier(0.32,0.72,0,1)] group-hover:shadow-[inset_0_1px_1px_rgba(255,255,255,0.7),0_26px_56px_-30px_rgba(68,64,60,0.55)]">
              <span class="flex size-11 items-center justify-center rounded-2xl bg-amber-700 text-white shadow-[0_10px_24px_-12px_rgba(180,83,9,0.8)] transition-transform duration-500 ease-[cubic-bezier(0.32,0.72,0,1)] group-hover:-translate-y-0.5 group-hover:rotate-3">
                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><%= raw icon %></svg>
              </span>
              <p class="mt-5 text-[11px] font-medium uppercase tracking-[0.2em] text-amber-700"><%= label %></p>
              <p class="font-marcellus mt-1 text-lg text-stone-900"><%= line1 %></p>
              <p class="mt-1 text-sm text-stone-500"><%= line2 %></p>
            </div>
          <% end %>
        </li>
      <% end %>
    </ul>
  </section>

  <%# ===== Form + Map split ===== %>
  <section class="mt-12 grid grid-cols-1 gap-8 lg:mt-14 lg:grid-cols-12 lg:gap-10">

    <%# Message form — primary, double-bezel ===== %>
    <div class="lg:col-span-7" data-controller="reveal">
      <div class="rounded-[2rem] bg-stone-50/60 p-1.5 ring-1 ring-stone-900/5 shadow-[0_30px_70px_-34px_rgba(68,64,60,0.5)]">
        <div class="rounded-[calc(2rem-0.375rem)] bg-white p-8 shadow-[inset_0_1px_1px_rgba(255,255,255,0.7)] md:p-10">
          <span class="inline-block rounded-full bg-amber-700/10 px-3 py-1 text-[11px] font-medium uppercase tracking-[0.25em] text-amber-800">Send a Message</span>
          <h2 class="font-marcellus mt-5 text-2xl text-stone-900 md:text-3xl">Start the conversation</h2>
          <div class="mt-5 h-px w-16 bg-amber-600"></div>

          <%= form_with url: pages_contact_path, method: :post, local: true, class: "mt-8 space-y-5" do %>
            <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
              <div>
                <label class="mb-1.5 block text-sm font-medium text-stone-700" for="contact_name">Your Name</label>
                <input type="text" id="contact_name" name="name" placeholder="Jane Smith" autocomplete="name"
                       class="block w-full rounded-xl bg-stone-100 px-4 py-3 ring-1 ring-stone-900/5 transition-all duration-300 ease-[cubic-bezier(0.32,0.72,0,1)] placeholder:text-stone-400 focus:bg-white focus:outline-none focus:ring-2 focus:ring-amber-500/50">
              </div>
              <div>
                <label class="mb-1.5 block text-sm font-medium text-stone-700" for="contact_email">Email Address</label>
                <input type="email" id="contact_email" name="email" placeholder="jane@example.com" autocomplete="email"
                       class="block w-full rounded-xl bg-stone-100 px-4 py-3 ring-1 ring-stone-900/5 transition-all duration-300 ease-[cubic-bezier(0.32,0.72,0,1)] placeholder:text-stone-400 focus:bg-white focus:outline-none focus:ring-2 focus:ring-amber-500/50">
              </div>
            </div>
            <div>
              <label class="mb-1.5 block text-sm font-medium text-stone-700" for="contact_message">Message</label>
              <textarea id="contact_message" name="message" rows="6" placeholder="How can we help you?"
                        class="block w-full resize-y rounded-xl bg-stone-100 px-4 py-3 ring-1 ring-stone-900/5 transition-all duration-300 ease-[cubic-bezier(0.32,0.72,0,1)] placeholder:text-stone-400 focus:bg-white focus:outline-none focus:ring-2 focus:ring-amber-500/50"></textarea>
            </div>
            <div class="flex flex-col items-start gap-4 pt-1 sm:flex-row sm:items-center sm:justify-between">
              <p class="text-sm text-stone-500">We&rsquo;ll never share your information.</p>
              <button type="submit" class="group inline-flex cursor-pointer items-center gap-3 rounded-full bg-stone-900 py-2 pl-6 pr-2 font-medium text-white transition-all duration-500 ease-[cubic-bezier(0.32,0.72,0,1)] hover:bg-stone-800 active:scale-[0.98]">
                <span>Send Message</span>
                <span class="flex h-9 w-9 items-center justify-center rounded-full bg-white/15 transition-transform duration-500 ease-[cubic-bezier(0.32,0.72,0,1)] group-hover:translate-x-0.5 group-hover:-translate-y-px">
                  <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                </span>
              </button>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <%# Map + invitation column ===== %>
    <div class="flex flex-col gap-8 lg:col-span-5" data-controller="reveal" data-reveal-delay-value="120">
      <%# Map in a double-bezel frame %>
      <div class="rounded-[2rem] bg-stone-50/60 p-1.5 ring-1 ring-stone-900/5 shadow-[0_30px_70px_-34px_rgba(68,64,60,0.5)]">
        <div class="overflow-hidden rounded-[calc(2rem-0.375rem)]">
          <iframe
            title="Map to West Baton Rouge Presbyterian Church, 640 Florida Ave, Port Allen, LA"
            src="https://www.google.com/maps?q=640+Florida+Ave,+Port+Allen,+LA+70767&output=embed"
            class="block aspect-[4/3] w-full lg:aspect-square"
            style="border:0;" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
        </div>
      </div>

      <%# Invitation card %>
      <div class="relative flex-1 overflow-hidden rounded-[2rem] bg-stone-900 p-8 text-stone-200 shadow-[0_30px_70px_-34px_rgba(68,64,60,0.6)]">
        <div class="pointer-events-none absolute -bottom-20 -right-16 h-56 w-56 rounded-full bg-amber-500/20 blur-3xl"></div>
        <div class="relative">
          <span class="inline-block rounded-full bg-amber-500/15 px-3 py-1 text-[11px] font-medium uppercase tracking-[0.25em] text-amber-300">Join Us Sunday</span>
          <h2 class="font-marcellus mt-5 text-2xl text-white">Come as you are</h2>
          <div class="mt-5 h-px w-16 bg-amber-500/60"></div>
          <p class="mt-5 leading-relaxed text-stone-300">
            No appointment needed &mdash; worship begins at 11:00 AM each Sunday. We&rsquo;ll save you a seat.
          </p>
          <%= link_to pages_about_path, class: "group mt-7 inline-flex items-center gap-3 rounded-full bg-amber-600 py-2 pl-6 pr-2 font-medium text-white transition-all duration-500 ease-[cubic-bezier(0.32,0.72,0,1)] hover:bg-amber-500 active:scale-[0.98]" do %>
            <span>Plan Your Visit</span>
            <span class="flex h-9 w-9 items-center justify-center rounded-full bg-white/15 transition-transform duration-500 ease-[cubic-bezier(0.32,0.72,0,1)] group-hover:translate-x-0.5 group-hover:-translate-y-px">
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </span>
          <% end %>
        </div>
      </div>
    </div>

  </section>
</div>
