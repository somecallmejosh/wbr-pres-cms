<%= turbo_frame_tag "calendar_frame" do %>
  <%# Month navigation %>
  <div class="flex items-center justify-between mb-4">
    <%= link_to calendar_path(month: @date.prev_month.month, year: @date.prev_month.year, category: @category),
        data: { turbo_frame: "calendar_frame" },
        aria: { label: "Previous month, #{@date.prev_month.strftime("%B %Y")}" },
        class: "rounded-md px-4 py-1.5 bg-stone-100 hover:bg-stone-200 text-stone-700 text-sm font-medium transition-colors" do %>
      <span aria-hidden="true">&larr;</span> Previous
    <% end %>
    <span class="font-marcellus text-xl text-stone-900" aria-live="polite" aria-atomic="true"><%= @date.strftime("%B %Y") %></span>
    <%= link_to calendar_path(month: @date.next_month.month, year: @date.next_month.year, category: @category),
        data: { turbo_frame: "calendar_frame" },
        aria: { label: "Next month, #{@date.next_month.strftime("%B %Y")}" },
        class: "rounded-md px-4 py-1.5 bg-stone-100 hover:bg-stone-200 text-stone-700 text-sm font-medium transition-colors" do %>
      Next <span aria-hidden="true">&rarr;</span>
    <% end %>
  </div>

  <%# Day-of-week headers %>
  <div class="grid grid-cols-7 bg-stone-800 rounded-t-lg mb-1">
    <% %w[Sun Mon Tue Wed Thu Fri Sat].each do |day_name| %>
      <div class="font-semibold text-center p-2 text-sm text-stone-200"><%= day_name %></div>
    <% end %>
  </div>

  <%# Calendar grid %>
  <div class="grid grid-cols-7 border border-stone-200 rounded-b-lg overflow-hidden">
    <%# Leading empty cells %>
    <% @date.beginning_of_month.wday.times do %>
      <div class="border-r border-b border-stone-100 p-2 bg-stone-50 min-h-24"></div>
    <% end %>

    <%# Day cells %>
    <% (@date.beginning_of_month..@date.end_of_month).each do |day| %>
      <%= render "calendar/calendar_day", day: day, events: @events_by_date[day] || [] %>
    <% end %>

    <%# Trailing empty cells %>
    <% (6 - @date.end_of_month.wday).times do %>
      <div class="border-r border-b border-stone-100 p-2 bg-stone-50 min-h-24"></div>
    <% end %>
  </div>
<% end %>
