<div id="<%= dom_id(gallery_image) %>"
     class="flex items-center gap-3 rounded-xl border border-stone-200 bg-white p-2.5 shadow-sm transition-shadow focus:outline-none focus-visible:ring-2 focus-visible:ring-amber-400"
     data-image-id="<%= gallery_image.image_id %>"
     data-sortable-id="<%= gallery_image.id %>"
     tabindex="0"
     role="listitem"
     aria-label="<%= gallery_image.image.title.presence || "Image #{gallery_image.position}" %>, position <%= gallery_image.position %>. Use arrow keys to reorder.">
  <span class="shrink-0 cursor-grab text-stone-400 transition-colors hover:text-stone-600" aria-hidden="true" data-sortable-handle>
    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
      <path d="M8.5 10a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3Zm0 7a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3Zm7-7a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3Zm0 7a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3Z"/>
    </svg>
  </span>
  <img src="<%= gallery_image.image.thumbnail_url(width: 80, height: 80) %>"
       alt=""
       aria-hidden="true"
       class="size-12 shrink-0 rounded-lg object-cover">
  <span class="flex-1 truncate text-sm text-stone-700"><%= gallery_image.image.title.presence || gallery_image.image.cloudinary_public_id %></span>
  <button type="button"
          class="shrink-0 inline-flex items-center gap-1.5 rounded-lg px-2.5 py-2 text-xs font-medium text-stone-500 transition-colors hover:bg-red-50 hover:text-red-600 focus:outline-none focus-visible:ring-2 focus-visible:ring-red-400"
          title="Remove from this gallery — the photo stays in your image library"
          aria-label="Remove <%= gallery_image.image.title.presence || "image" %> from this gallery"
          data-action="gallery-editor#remove">
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/>
    </svg>
    <span class="hidden sm:inline">Remove</span>
  </button>
</div>
