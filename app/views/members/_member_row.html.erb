<tr class="border-b border-gray-200 hover:bg-gray-50">
  <td class="py-3 px-4">
    <%= link_to member.full_name, member_path(member), class: "text-blue-700 hover:underline" %>
  </td>
  <td class="py-3 px-4 hidden sm:table-cell"><%= member.email %></td>
  <td class="py-3 px-4 hidden md:table-cell"><%= member.phone %></td>
  <td class="py-3 px-4 hidden lg:table-cell"><%= member.birthday_display %></td>
  <td class="py-3 px-4">
    <%= link_to "Edit", edit_member_path(member), class: "text-blue-700 hover:underline" %>
  </td>
</tr>
