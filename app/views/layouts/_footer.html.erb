<footer class="bg-stone-900 text-stone-300 border-t-2 border-amber-600/50 mt-auto">
  <div class="container mx-auto px-4 py-8">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <div>
        <h3 class="font-marcellus text-white text-lg mb-3">Quick Links</h3>
        <ul class="space-y-1 text-sm">
          <li><%= link_to "Home", root_path, class: "hover:text-amber-400 transition-colors py-1 block" %></li>
          <li><%= link_to "Events", events_path, class: "hover:text-amber-400 transition-colors py-1 block" %></li>
          <li><%= link_to "Calendar", calendar_path, class: "hover:text-amber-400 transition-colors py-1 block" %></li>
          <li><%= link_to "Galleries", galleries_path, class: "hover:text-amber-400 transition-colors py-1 block" %></li>
          <li><%= link_to "About", pages_about_path, class: "hover:text-amber-400 transition-colors py-1 block" %></li>
          <li><%= link_to "Contact", pages_contact_path, class: "hover:text-amber-400 transition-colors py-1 block" %></li>
        </ul>
      </div>

      <div>
        <h3 class="font-marcellus text-white text-lg mb-3">West Baton Rouge Presbyterian</h3>
        <address class="not-italic text-sm space-y-1">
          <p>640 Florida Ave</p>
          <p>Port Allen, LA 70767</p>
          <p class="mt-2"><a href="tel:+12253441486" class="hover:text-amber-400 transition-colors">(225) 344-1486</a></p>
          <p><a href="mailto:office@wbrpres.org" class="hover:text-amber-400 transition-colors">office@wbrpres.org</a></p>
        </address>
      </div>

      <div>
        <h3 class="font-marcellus text-white text-lg mb-3">Worship</h3>
        <p class="text-sm">Sunday Service: 11:00 AM</p>
        <nav aria-label="Footer account navigation" class="mt-6">
          <ul class="space-y-1 text-sm">
            <% if authenticated? %>
              <li><%= link_to "Log Out", session_path, data: { turbo_method: :delete }, class: "text-sm text-stone-400 hover:text-amber-400 transition-colors" %></li>
              <li><%= link_to "Dashboard",dashboard_path, class: "text-sm text-stone-400 hover:text-amber-400 transition-colors" %></li>
            <% else %>
              <li><%= link_to "Staff Sign In", new_session_path, class: "text-sm text-stone-200 hover:text-amber-400 transition-colors" %></li>
            <% end %>
          </ul>
        </nav>
      </div>
    </div>

    <div class="border-t border-stone-700 mt-8 pt-4 text-center text-xs text-stone-100">
      <p>&copy; <%= Time.current.year %> West Baton Rouge Presbyterian Church. All rights reserved.</p>
    </div>
  </div>
</footer>
