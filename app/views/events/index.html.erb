<div class="container mx-auto px-4 py-8">
  <div class="flex items-center justify-between mb-6">
    <h1 class="font-marcellus text-4xl text-stone-900">Events</h1>
    <% if authenticated? %>
      <%= link_to "New Event", new_event_path, class: "rounded-md px-4 py-2 bg-stone-700 hover:bg-stone-600 text-white font-medium transition-colors" %>
    <% end %>
  </div>

  <div class="flex flex-wrap gap-2 mb-8">
    <%= link_to "All", events_path, class: "rounded-full px-4 py-1.5 text-sm font-medium transition-colors #{params[:category].blank? ? 'bg-stone-800 text-white' : 'bg-stone-100 text-stone-700 hover:bg-stone-200'}" %>
    <% Event::CATEGORY_LABELS.each do |value, label| %>
      <%= link_to label, events_path(category: value), class: "rounded-full px-4 py-1.5 text-sm font-medium transition-colors #{params[:category] == value ? 'bg-stone-800 text-white' : 'bg-stone-100 text-stone-700 hover:bg-stone-200'}" %>
    <% end %>
  </div>

  <% if @events.any? %>
    <div class="grid lg:grid-cols-3 gap-6">
      <% @events.each do |event| %>
        <%= render "events/event_row", event: event %>
      <% end %>
    </div>
  <% else %>
    <p class="text-stone-600">No upcoming events.</p>
  <% end %>
</div>
