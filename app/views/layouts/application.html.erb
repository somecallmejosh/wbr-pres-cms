<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "Wbr Pres Cms" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Wbr Pres Cms">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%# Social meta tags %>
    <% _og_title       = content_for?(:og_title)       ? yield(:og_title)       : (content_for?(:title) ? yield(:title) : "West Baton Rouge Presbyterian Church") %>
    <% _og_description = content_for?(:og_description) ? yield(:og_description) : ApplicationHelper::SITE_DESCRIPTION %>
    <% _og_image       = content_for?(:og_image)       ? yield(:og_image)       : og_image_url %>
    <% _og_url         = content_for?(:og_url)         ? yield(:og_url)         : request.url %>
    <meta name="description"         content="<%= _og_description %>">
    <meta property="og:type"        content="website">
    <meta property="og:site_name"   content="West Baton Rouge Presbyterian Church">
    <meta property="og:title"       content="<%= _og_title %>">
    <meta property="og:description" content="<%= _og_description %>">
    <meta property="og:image"       content="<%= _og_image %>">
    <meta property="og:image:width"  content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:url"         content="<%= _og_url %>">
    <meta name="twitter:card"        content="summary_large_image">
    <meta name="twitter:title"       content="<%= _og_title %>">
    <meta name="twitter:description" content="<%= _og_description %>">
    <meta name="twitter:image"       content="<%= _og_image %>">

    <%# Structured data: baseline church identity on every page, plus any
        page-specific block (Event, ImageGallery) layered on via content_for. %>
    <%= json_ld_tag(church_json_ld) %>
    <%= yield :json_ld %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="icon" href="/favicon.ico" sizes="32x32">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <script defer src="https://unpkg.com/@alpinejs/ui@3.15.8/dist/cdn.min.js"></script>
    <script defer src="https://unpkg.com/@alpinejs/focus@3.15.8/dist/cdn.min.js"></script>
    <script defer src="https://unpkg.com/alpinejs@3.15.8/dist/cdn.min.js"></script>
  </head>

  <body
    class="flex flex-col min-h-dvh bg-stone-50 text-stone-800"
    x-data="{ menuOpen: false, open: false }"
  >
    <%= render "/layouts/navbar" %>
    <%= render "/layouts/mobile_nav" %>
    <div id="flash"><%= render "/layouts/flash" %></div>
    <main class="flex-1 flex flex-col relative z-10" id="main-content">
      <%= yield %>
    </main>
    <% if (verse = closing_verse) %>
      <%= render "shared/spiritual_statement", label: verse[:label], quote: verse[:quote], reference: verse[:reference] %>
    <% end %>
    <%= render "/layouts/footer" %>
  </body>
</html>
