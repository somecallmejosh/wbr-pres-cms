<% content_for :title, "#{@event.title} — West Baton Rouge Presbyterian Church" %>
<div class="container mx-auto px-4 py-12 md:py-16">
  <div class="mb-8">
    <%= link_to events_path, class: "group inline-flex items-center gap-2 text-sm font-medium text-amber-700 transition-colors hover:text-amber-800" do %>
      <span class="transition-transform duration-500 ease-[cubic-bezier(0.32,0.72,0,1)] group-hover:-translate-x-1">&larr;</span>
      <span>Back to Events</span>
    <% end %>
  </div>

  <div class="max-w-3xl" data-controller="reveal">

    <div class="mb-6 flex items-start justify-between">
      <div>
        <%= render "shared/category_badge", category: @event.category %>
        <h1 class="font-marcellus mt-3 text-4xl text-stone-900 md:text-5xl leading-tight"><%= @event.title %></h1>
      </div>
      <% if authenticated? %>
        <div class="ml-4 flex shrink-0 gap-2">
          <%= link_to "Edit", edit_event_path(@event), class: "rounded-full px-4 py-2 bg-stone-700 hover:bg-stone-600 text-white text-sm font-medium transition-colors" %>
          <%= button_to "Delete", event_path(@event), method: :delete,
                class: "rounded-full px-4 py-2 bg-red-700 hover:bg-red-600 text-white text-sm font-medium cursor-pointer transition-colors",
                data: { turbo_confirm: "Are you sure you want to delete this event?" } %>
        </div>
      <% end %>
    </div>

    <% if @event.image.present? %>
      <div class="overflow-hidden rounded-[2rem] ring-1 ring-stone-900/5 shadow-[0_24px_60px_-30px_rgba(68,64,60,0.45)]">
        <img src="<%= @event.image.display_url(width: 800) %>"
             alt="Event image"
             class="aspect-[16/9] w-full object-cover">
      </div>
    <% end %>

    <dl class="mt-8 divide-y divide-stone-200">
      <div class="py-4 sm:grid sm:grid-cols-3 sm:gap-4">
        <dt class="font-semibold text-stone-700">Date</dt>
        <dd class="text-stone-800 sm:col-span-2"><%= full_date_ordinal_with_year(@event.event_date) %></dd>
      </div>
      <div class="py-4 sm:grid sm:grid-cols-3 sm:gap-4">
        <dt class="font-semibold text-stone-700">Time</dt>
        <dd class="text-stone-800 sm:col-span-2"><%= event_time_range(@event) %></dd>
      </div>
      <% if @event.location.present? %>
        <div class="py-4 sm:grid sm:grid-cols-3 sm:gap-4">
          <dt class="font-semibold text-stone-700">Location</dt>
          <dd class="text-stone-800 sm:col-span-2"><%= @event.location %></dd>
        </div>
      <% end %>
      <% if @event.description.present? %>
        <div class="py-4 sm:grid sm:grid-cols-3 sm:gap-4">
          <dt class="font-semibold text-stone-700">Description</dt>
          <dd class="text-stone-700 sm:col-span-2"><%= simple_format(@event.description) %></dd>
        </div>
      <% end %>
    </dl>
  </div>
</div>
