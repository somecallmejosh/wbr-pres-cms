<%= form_with model: gallery, class: "max-w-2xl" do |form| %>
  <% if gallery.errors.any? %>
    <div class="bg-red-50 border border-red-300 rounded-md p-4 mb-6" role="alert">
      <h2 class="font-semibold text-red-800"><%= pluralize(gallery.errors.count, "error") %> prevented this gallery from being saved:</h2>
      <ul class="list-disc list-inside mt-2 text-red-700">
        <% gallery.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid grid-cols-1 gap-4">
    <div>
      <%= form.label :title, class: "block font-semibold text-gray-700 mb-1" %>
      <%= form.text_field :title, required: true, class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 w-full" %>
    </div>

    <div>
      <%= form.label :description, class: "block font-semibold text-gray-700 mb-1" %>
      <%= form.text_area :description, rows: 4, class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 w-full" %>
    </div>

    <div class="flex items-center gap-3">
      <%= form.check_box :published, class: "rounded border-gray-400 text-blue-600 focus:ring-blue-500 size-4" %>
      <%= form.label :published, "Published (visible to the public)", class: "font-semibold text-gray-700" %>
    </div>
  </div>

  <% if @images.present? %>
    <%= render "galleries/image_picker", selected_ids: gallery.images.pluck(:id) %>
  <% end %>

  <div class="mt-6">
    <%= form.submit class: "rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white font-medium cursor-pointer" %>
  </div>
<% end %>
