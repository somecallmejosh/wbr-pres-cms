<article class="group flex h-full flex-col overflow-hidden rounded-2xl bg-white ring-1 ring-stone-900/5 shadow-[0_12px_30px_-18px_rgba(68,64,60,0.45)] transition-all duration-500 ease-[cubic-bezier(0.32,0.72,0,1)] hover:-translate-y-1 hover:shadow-[0_28px_60px_-28px_rgba(68,64,60,0.55)]">
  <div class="relative overflow-hidden">
    <% if gallery.cover_image %>
      <%= link_to gallery_path(gallery), aria: { label: gallery.title }, class: "block" do %>
        <img src="<%= gallery.cover_image.thumbnail_url(width: 800, height: 450) %>"
             alt=""
             aria-hidden="true"
             class="aspect-[16/9] w-full object-cover transition-transform duration-700 ease-[cubic-bezier(0.32,0.72,0,1)] group-hover:scale-[1.04]">
      <% end %>
    <% else %>
      <div class="flex aspect-[16/9] w-full items-center justify-center bg-stone-100 text-sm text-stone-400" aria-hidden="true">
        No images
      </div>
    <% end %>
    <span class="absolute right-3 top-3 rounded-full bg-stone-900/70 px-3 py-1 text-xs font-medium text-white backdrop-blur">
      <%= pluralize(gallery.images.size, "photo") %>
    </span>
  </div>

  <div class="flex flex-1 flex-col p-5">
    <h2 class="font-marcellus text-lg text-stone-900">
      <%= link_to gallery.title, gallery_path(gallery), class: "transition-colors hover:text-amber-700" %>
    </h2>
    <% if gallery.description.present? %>
      <p class="mt-2 line-clamp-2 text-sm text-stone-600"><%= gallery.description %></p>
    <% end %>
    <% if authenticated? %>
      <div class="mt-4 border-t border-stone-100 pt-3">
        <%= link_to "Edit", edit_gallery_path(gallery), class: "text-sm font-medium text-amber-700 transition-colors hover:text-amber-800" %>
      </div>
    <% end %>
  </div>
</article>
