<div class="container mx-auto p-4">
  <section class="mb-8">
    <h2 class="font-bold text-2xl mb-4">This Week's Events</h2>

    <% if @weekly_events.any? %>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <% @weekly_events.each do |event| %>
          <%= render "events/event_card", event: event %>
        <% end %>
      </div>
    <% else %>
      <p class="text-gray-500">No events scheduled this week.</p>
    <% end %>
  </section>

  <section>
    <h2 class="font-bold text-2xl mb-4"><%= Date.current.strftime("%B") %> Birthdays</h2>

    <% if @birthdays.any? %>
      <ul class="divide-y divide-gray-200">
        <% @birthdays.each do |member| %>
          <li class="py-3 flex justify-between items-center">
            <span class="font-medium"><%= member.full_name %></span>
            <span class="text-gray-600"><%= member.birthday_display %></span>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="text-gray-500">No birthdays this month.</p>
    <% end %>
  </section>
</div>
