<div class="group relative flex h-full flex-col overflow-hidden rounded-2xl bg-white ring-1 ring-stone-900/5 shadow-[0_12px_30px_-18px_rgba(68,64,60,0.45)] transition-all duration-500 ease-[cubic-bezier(0.32,0.72,0,1)] hover:-translate-y-1 hover:shadow-[0_28px_60px_-28px_rgba(68,64,60,0.55)]">
  <div class="relative overflow-hidden">
    <% if event.image.present? %>
      <img src="<%= event.image.display_url(width: 800) %>"
           alt=""
           aria-hidden="true"
           class="aspect-[16/9] w-full object-cover transition-transform duration-700 ease-[cubic-bezier(0.32,0.72,0,1)] group-hover:scale-[1.04]"
           loading="lazy">
    <% else %>
      <div class="flex aspect-[16/9] w-full items-center justify-center bg-stone-100 text-sm text-stone-400" aria-hidden="true">
        No image
      </div>
    <% end %>
    <div class="absolute left-4 top-4 flex w-16 flex-col items-center justify-center rounded-xl bg-white/95 px-2 py-2.5 text-center shadow-[0_8px_20px_-10px_rgba(0,0,0,0.5)] backdrop-blur">
      <span class="text-[10px] font-semibold uppercase tracking-widest text-stone-500"><%= event.event_date.strftime("%a") %></span>
      <span class="my-0.5 text-2xl font-bold leading-none text-stone-800"><%= event.event_date.day %></span>
      <span class="text-[10px] font-semibold uppercase tracking-widest text-stone-500"><%= event.event_date.strftime("%b") %></span>
    </div>
  </div>

  <div class="flex flex-1 flex-col p-5">
    <div class="mb-2 flex flex-wrap items-center gap-2 lg:justify-between">
      <h2 class="font-marcellus text-lg text-stone-900 transition-colors group-hover:text-amber-700">
        <%= event.title %>
      </h2>
      <%= render "shared/category_badge", category: event.category %>
    </div>
    <p class="text-sm text-stone-500"><%= event_time_range(event) %></p>
    <% if event.description.present? %>
      <p class="mt-2 line-clamp-2 text-sm text-stone-600"><%= event.description %></p>
    <% end %>
    <% if event.location.present? %>
      <p class="mt-1 text-sm text-stone-500"><%= event.location %></p>
    <% end %>
  </div>

  <%= link_to event_path(event), class: "absolute inset-0 block rounded-2xl focus:outline-none focus-visible:ring-2 focus-visible:ring-amber-500 focus-visible:ring-offset-2" do %>
    <span class="sr-only"><%= event.title %></span>
  <% end %>
</div>
