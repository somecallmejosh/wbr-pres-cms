<% content_for :title, "#{@gallery.title} — West Baton Rouge Presbyterian Church" %>
<div class="container mx-auto px-4 py-12 md:py-16">
  <div class="mb-8">
    <%= link_to galleries_path, class: "group inline-flex items-center gap-2 text-sm font-medium text-amber-700 transition-colors hover:text-amber-800" do %>
      <span class="transition-transform duration-500 ease-[cubic-bezier(0.32,0.72,0,1)] group-hover:-translate-x-1">&larr;</span>
      <span>Back to Galleries</span>
    <% end %>
  </div>

  <div class="mb-10 flex items-start justify-between">
    <div>
      <span class="inline-block rounded-full bg-amber-700/10 px-3 py-1 text-[11px] font-medium uppercase tracking-[0.25em] text-amber-800">Gallery</span>
      <h1 class="font-marcellus mt-3 text-4xl text-stone-900 md:text-5xl leading-tight"><%= @gallery.title %></h1>
      <div class="mt-4 h-px w-16 bg-amber-600"></div>
      <% if @gallery.description.present? %>
        <p class="mt-4 max-w-2xl text-lg text-stone-600"><%= @gallery.description %></p>
      <% end %>
    </div>
    <% if authenticated? %>
      <div class="ml-4 flex shrink-0 gap-2">
        <%= link_to "Edit", edit_gallery_path(@gallery), class: "rounded-full px-4 py-2 bg-stone-700 hover:bg-stone-600 text-white text-sm font-medium transition-colors" %>
        <%= button_to "Delete", gallery_path(@gallery), method: :delete,
              class: "rounded-full px-4 py-2 bg-red-700 hover:bg-red-600 text-white text-sm font-medium cursor-pointer transition-colors",
              data: { turbo_confirm: "Are you sure you want to delete this gallery?" } %>
      </div>
    <% end %>
  </div>

  <% if @gallery_images.any? %>
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-4"
         data-controller="lightbox"
         role="list"
         aria-label="<%= @gallery.title %> images">
      <% @gallery_images.each_with_index do |gi, index| %>
        <div role="listitem">
          <button type="button"
                  class="group block aspect-square w-full cursor-pointer overflow-hidden rounded-xl ring-1 ring-stone-900/5 transition-all duration-500 ease-[cubic-bezier(0.32,0.72,0,1)] hover:-translate-y-0.5 hover:shadow-[0_20px_40px_-22px_rgba(68,64,60,0.5)] focus:outline-none focus:ring-2 focus:ring-amber-500 focus:ring-offset-2"
                  data-lightbox-target="item"
                  data-lightbox-src="<%= gi.image.display_url(width: 1600) %>"
                  data-lightbox-alt="<%= gi.image.alt_text.presence || gi.image.title.presence || "" %>"
                  data-action="click->lightbox#open"
                  aria-label="<%= "View #{gi.image.title.presence || "image #{index + 1}"} — click to enlarge" %>">
            <img src="<%= gi.image.thumbnail_url(width: 800, height: 800) %>"
                 alt=""
                 aria-hidden="true"
                 class="h-full w-full object-cover transition-transform duration-700 ease-[cubic-bezier(0.32,0.72,0,1)] group-hover:scale-[1.06]">
          </button>
        </div>
      <% end %>
    </div>
  <% else %>
    <p class="text-stone-600">No images in this gallery yet.</p>
  <% end %>
</div>
