<div class="container mx-auto p-4">
  <h1 class="font-bold text-4xl mb-6">Church Calendar</h1>

  <%# Category filter links (outside Turbo Frame) %>
  <div class="flex flex-wrap gap-2 mb-6">
    <%= link_to "All", calendar_path(month: @date.month, year: @date.year),
        class: "rounded-full px-3 py-1 text-sm font-medium #{@category.blank? ? 'bg-gray-800 text-white' : 'bg-gray-200 text-gray-700 hover:bg-gray-300'}" %>
    <% Event::CATEGORY_LABELS.each do |value, label| %>
      <%= link_to label, calendar_path(month: @date.month, year: @date.year, category: value),
          class: "rounded-full px-3 py-1 text-sm font-medium #{@category == value ? 'bg-gray-800 text-white' : 'bg-gray-200 text-gray-700 hover:bg-gray-300'}" %>
    <% end %>
  </div>

  <%= render "calendar/calendar_grid" %>
</div>
