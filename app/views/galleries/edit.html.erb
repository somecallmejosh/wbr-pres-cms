<div class="container mx-auto px-4 py-8">
  <div class="mb-6">
    <%= link_to "&larr; Back to Gallery".html_safe, gallery_path(@gallery), class: "text-amber-700 hover:text-amber-800 transition-colors font-medium" %>
  </div>

  <h1 class="font-marcellus text-4xl text-stone-900 mb-6">Edit Gallery</h1>

  <% if @gallery_images.any? %>
    <section class="mb-8 max-w-2xl" aria-labelledby="reorder-heading">
      <h2 id="reorder-heading" class="font-medium text-stone-700 mb-2">
        Current Images
        <span class="text-sm font-normal text-stone-600">(drag to reorder, or use arrow keys)</span>
      </h2>
      <div class="flex flex-col gap-2"
           data-controller="sortable"
           data-sortable-url-value="<%= reorder_gallery_path(@gallery) %>"
           role="list"
           aria-label="Gallery images, drag or use arrow keys to reorder">
        <% @gallery_images.each do |gallery_image| %>
          <%= render "galleries/sortable_image", gallery_image: gallery_image %>
        <% end %>
      </div>
    </section>
  <% end %>

  <%= render "galleries/form", gallery: @gallery %>
</div>
