<%= form_with model: event, class: "max-w-2xl" do |form| %>
  <% if event.errors.any? %>
    <div class="bg-red-50 border border-red-200 rounded-md p-4 mb-6">
      <h2 class="font-semibold text-red-800"><%= pluralize(event.errors.count, "error") %> prevented this event from being saved:</h2>
      <ul class="list-disc list-inside mt-2 text-red-700">
        <% event.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid grid-cols-1 gap-5">
    <div>
      <%= form.label :title, class: "block font-medium text-stone-700 mb-1" %>
      <%= form.text_field :title, required: true, class: "block shadow-sm rounded-md border border-stone-300 focus:outline-none focus:ring-2 focus:ring-amber-400 focus:border-amber-400 px-3 py-2 w-full" %>
    </div>

    <div>
      <%= form.label :description, class: "block font-medium text-stone-700 mb-1" %>
      <%= form.text_area :description, rows: 4, class: "block shadow-sm rounded-md border border-stone-300 focus:outline-none focus:ring-2 focus:ring-amber-400 focus:border-amber-400 px-3 py-2 w-full resize-y" %>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
      <div>
        <%= form.label :event_date, "Date", class: "block font-medium text-stone-700 mb-1" %>
        <%= form.date_field :event_date, required: true, class: "block shadow-sm rounded-md border border-stone-300 focus:outline-none focus:ring-2 focus:ring-amber-400 focus:border-amber-400 px-3 py-2 w-full" %>
      </div>

      <div>
        <%= form.label :start_time, "Start Time", class: "block font-medium text-stone-700 mb-1" %>
        <%= form.time_field :start_time, required: true, class: "block shadow-sm rounded-md border border-stone-300 focus:outline-none focus:ring-2 focus:ring-amber-400 focus:border-amber-400 px-3 py-2 w-full" %>
      </div>

      <div>
        <%= form.label :end_time, "End Time", class: "block font-medium text-stone-700 mb-1" %>
        <%= form.time_field :end_time, class: "block shadow-sm rounded-md border border-stone-300 focus:outline-none focus:ring-2 focus:ring-amber-400 focus:border-amber-400 px-3 py-2 w-full" %>
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <%= form.label :location, class: "block font-medium text-stone-700 mb-1" %>
        <%= form.text_field :location, class: "block shadow-sm rounded-md border border-stone-300 focus:outline-none focus:ring-2 focus:ring-amber-400 focus:border-amber-400 px-3 py-2 w-full" %>
      </div>

      <div>
        <%= form.label :category, class: "block font-medium text-stone-700 mb-1" %>
        <%= form.select :category, Event::CATEGORY_LABELS.map { |value, label| [label, value] }, { include_blank: "Select a category" }, required: true, class: "block shadow-sm rounded-md border border-stone-300 focus:outline-none focus:ring-2 focus:ring-amber-400 focus:border-amber-400 px-3 py-2 w-full" %>
      </div>
    </div>
  </div>

  <% if @images.present? %>
    <div class="mt-5">
      <%= form.label :image_id, "Event Image", class: "block font-medium text-stone-700 mb-2" %>
      <div class="grid grid-cols-3 sm:grid-cols-4 md:grid-cols-5 gap-3">
        <label class="relative cursor-pointer">
          <%= form.radio_button :image_id, "", class: "sr-only peer" %>
          <div class="flex items-center justify-center h-24 rounded-md border-2 border-stone-200 bg-stone-50 text-stone-400 text-xs text-center peer-checked:border-amber-500 peer-checked:bg-amber-50 hover:border-stone-300 transition-colors">
            No image
          </div>
        </label>
        <% @images.each do |image| %>
          <label class="relative cursor-pointer">
            <%= form.radio_button :image_id, image.id, class: "sr-only peer" %>
            <div class="h-24 rounded-md border-2 border-stone-200 bg-stone-100 overflow-hidden peer-checked:border-amber-500 hover:border-stone-300 transition-colors">
              <img src="<%= image.thumbnail_url(width: 200, height: 200) %>"
                   alt="<%= image.alt_text.presence || image.title.presence || "" %>"
                   class="w-full h-full object-cover">
            </div>
            <% if image.title.present? %>
              <p class="mt-1 text-xs text-stone-600 truncate"><%= image.title %></p>
            <% end %>
          </label>
        <% end %>
      </div>
    </div>
  <% end %>

  <div class="mt-6">
    <%= form.submit class: "rounded-md px-4 py-2.5 bg-stone-700 hover:bg-stone-600 text-white font-medium cursor-pointer transition-colors" %>
  </div>
<% end %>
